          "settings": {
            "rate": 1
          }
        },
        "bypassed": false,
        "position": {
          "x": 730,
          "y": 690
        }
      },
      {
        "id": "tts",
        "type": "core/tts-engine",
        "params": {
          "speed": 1
        },
        "bypassed": false,
        "position": {
          "x": 1080,
          "y": 340
        }
      },
      {
        "id": "assembler",
        "type": "core/timeline-assembler",
        "params": {
          "fps": 30,
          "width": 1080,
          "height": 1920,
          "minTotalFrames": 300,
          "title": "Quote cards"
        },
        "bypassed": false,
        "position": {
          "x": 1400,
          "y": 40
        }
      },
      {
        "id": "engine",
        "type": "core/hyperframes-engine",
