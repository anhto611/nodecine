3.out'},.3)\n      .fromTo(q('.item .title'),{y:46,opacity:0},{y:0,opacity:1,duration:.7,ease:'power3.out'},.42)\n      .fromTo(q('.hair-one'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.6,ease:'power2.out'},.72)\n      .fromTo(q('.item .detail'),{y:26,opacity:0},{y:0,opacity:1,duration:.6,ease:'power2.out'},.82)\n      tl.fromTo(q('.bc'),{opacity:0,y:-12},{opacity:1,y:0,duration:.5,ease:'power2.out'},0);\n      tl.fromTo(q('.sc'),{y:14,opacity:0},{y:0,opacity:1,duration:.5,ease:'power2.out'},.8);\n      tl.fromTo(q('.pr-fill'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.7,ease:'power2.out'},.2);\n  tl.set({},{},duration);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['digest-item']=tl;\n})();</script>\n</template></body></html>",
            "compositions/digest-close.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"4\" data-role=\"outro\" data-composition-variables=\"[{&quot;id&quot;:&quot;title&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;Closing line&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Câu kết&quot;},&quot;default&quot;:&quot;What to watch next&quot;,&quot;sample&quot;:&quot;Watch the next minor release&quot;,&quot;maxLength&quot;:56,&quot;required&quot;:true},{&quot;id&quot;:&quot;detail&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;One sentence to close on&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Một câu kết&quot;},&quot;default&quot;:&quot;The thread to follow once today is old news.&quot;,&quot;sample&quot;:&quot;If the plugin returns, this whole week gets rewritten.&quot;,&quot;maxLength&quot;:150,&quot;required&quot;:true},{&quot;id&quot;:&quot;step&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Which scene this is&quot;,&quot;default&quot;:3,&quot;required&quot;:true},{&quot;id&quot;:&quot;total&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;How many scenes the film has&quot;,&quot;default&quot;:3,&quot;required&quot;:true},{&quot;id&quot;:&quot;seconds&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Length in seconds (the Assemble node gives it)&quot;,&quot;default&quot;:4}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"Closing: what to watch next, against the axis mirrored on the right.\" /></head>\n<body><template>\n<style>html,body{margin:0;background:#070a11}*{box-sizing:border-box}#root{position:absolute;inset:0;width:1080px;height:1920px;overflow:hidden;color:#eef2f8;background:#070a11;font-family:var(--font-body,Inter,Arial,sans-serif)}.nc-backdrop{position:absolute;inset:0;background:linear-gradient(180deg,#0d1728 0,#070a11 46%,#05070c 100%)}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff08 1px,transparent 1px);background-size:100% 96px}.eyebrow{position:absolute;color:#5ee6a8;font-size:21px;font-weight:850;letter-spacing:.2em}.hair{position:absolute;height:1px;background:#2b4468}.slot-brand{position:absolute;right:96px;top:98px;width:400px;height:52px}.slot-rail{position:absolute;left:110px;right:150px;bottom:112px;height:40px}.slot-index{position:absolute;left:560px;right:150px;top:1256px;height:230px}.slot-chip{position:absolute;left:190px;right:150px;top:1330px;height:86px}.bc{position:absolute;inset:0;display:flex;align-items:center;gap:16px}.bc-label{color:#9fb4d4;font-size:22px;font-weight:850;letter-spacing:.14em}.bc-bug{display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:#5ee6a8;color:#06231a;font-size:31px;font-weight:1000;letter-spacing:-.1em}.bc-bug i{width:7px;height:7px;border-radius:50%;background:#06231a;margin-top:18px}.pr{position:absolute;inset:0;display:flex;align-items:center;gap:20px}.pr-rail{flex:1;height:8px;border-radius:4px;background:#1c2b3d;overflow:hidden}.pr-fill{display:block;height:100%;width:0;border-radius:4px;background:#5ee6a8}.pr-count{color:#8fa6c6;font-size:19px;font-weight:850;letter-spacing:.14em}.axis{position:absolute;right:110px;top:180px;bottom:300px;width:7px;border-radius:7px;background:#5ee6a8}.end{position:absolute;left:190px;top:186px;display:flex;align-items:center;gap:14px;color:#8fa6c6;font-size:20px;letter-spacing:.2em;font-weight:800}.end b{display:block;width:10px;height:10px;border-radius:50%;background:#5ee6a8}.close .title{position:absolute;left:150px;right:190px;top:420px;margin:0;text-align:right;font-size:96px;line-height:1.06;letter-spacing:-.03em;font-weight:850;max-height:520px;overflow:hidden}.hair-one{left:190px;right:190px;top:1010px}.close .detail{position:absolute;left:200px;right:190px;top:1076px;margin:0;text-align:right;font-size:38px;line-height:1.36;color:#c3d3e8;max-height:220px;overflow:hidden}</style>\n<div id=\"root\" data-composition-id=\"digest-close\" data-duration=\"4\" data-width=\"1080\" data-height=\"1920\"><div class=\"nc-backdrop\"></div><div class=\"grid\"></div>\n      <span class=\"slot slot-brand\"><span class=\"bc\"><span class=\"bc-bug\">N<i></i></span><span class=\"bc-label\">TECH DIGEST</span></span></span>\n      <div class=\"end\"><b></b><span>END OF FEED</span></div>\n      <div class=\"axis\"></div>\n      <div class=\"close\"><h1 class=\"title\"></h1><div class=\"hair hair-one\"></div><p class=\"detail\"></p></div>\n      <span class=\"slot slot-rail\"><span class=\"pr\"><span class=\"pr-rail\"><span class=\"pr-fill\"></span></span><span class=\"pr-count\"></span></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  ['title','detail','source'].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"title\":\"What to watch next\",\"detail\":\"The thread to follow once today is old news.\",\"step\":3,\"total\":3,\"seconds\":4}[key]:v[key])})});\n  var number=root.querySelector('.number-value');if(number)number.textContent=String(v.number==null?'01':v.number).padStart(2,'0');\n  root.querySelectorAll('.title,.detail').forEach(function(el){var floor=el.classList.contains('title')?62:29;while(el.scrollHeight>el.clientHeight+2&&parseFloat(getComputedStyle(el).fontSize)>floor){el.style.fontSize=(parseFloat(getComputedStyle(el).fontSize)-2)+'px'}});\n  var railEl=root.querySelector('.pr-fill');var stepN=Number(v.step)||1;var totalN=Math.max(1,Number(v.total)||1);if(railEl)railEl.style.width=Math.min(100,Math.round((stepN/totalN)*100))+'%';var countEl=root.querySelector('.pr-count');if(countEl)countEl.textContent=String(stepN).padStart(2,'0')+' / '+String(totalN).padStart(2,'0');\n  var duration=Math.max(2,Number(v.seconds)||Number(root.dataset.duration)||4);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.grid'),{opacity:0},{opacity:1,duration:1,ease:'sine.out'},0)\n      .fromTo(q('.end'),{opacity:0,x:-16},{opacity:1,x:0,duration:.5,ease:'power2.out'},.1)\n      .fromTo(q('.axis'),{scaleY:0,transformOrigin:'top center'},{scaleY:1,duration:.8,ease:'power2.out'},.16)\n      .fromTo(q('.close .title'),{y:50,opacity:0},{y:0,opacity:1,duration:.8,ease:'power3.out'},.3)\n      .fromTo(q('.hair-one'),{scaleX:0,transformOrigin:'right center'},{scaleX:1,duration:.6,ease:'power2.out'},.7)\n      .fromTo(q('.close .detail'),{y:26,opacity:0},{y:0,opacity:1,duration:.6,ease:'power2.out'},.8)\n      tl.fromTo(q('.bc'),{opacity:0,y:-12},{opacity:1,y:0,duration:.5,ease:'power2.out'},0);\n      tl.fromTo(q('.pr-fill'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.7,ease:'power2.out'},.2);\n  tl.set({},{},duration);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['digest-close']=tl;\n})();</script>\n</template></body></html>",
            "storyboard-guide.md": "---\nfirst: hook\nlast: outro\nrepeat: 3\n---\nMake a short technology digest in English, vertical 9:16, about 55–65 seconds, laid out as a feed: an opening on the left axis, one numbered row per item, a close against the right axis.\nUse only what is in Research and the URLs the person gave. Never invent a number, a date, a version or a quote.\nEvery scene carries its own place in the film: step (1 for the opening, then 2, 3 … for the items, and the last number for the close) and total (how many scenes the film has). The running bar at the foot of every scene reads those two.\nEvery item scene carries a two-digit number in order (01, 02, 03), a headline of at most 56 characters, one sentence that says what happened and why it matters, and the source of that item as a bare domain of at most 40 characters; the source strip at the foot of the item reads that.\nThe kit also publishes components a writer may mount into a frame of its own: brand-corner (the mark and the film's name), ticker-index (a numbered index), source-chip and progress-rail (the two the scenes already paste). Mount one only where the scene does not already carry it.\nDrop an item when Research has no evidence for it; three short items beat three padded ones. Do not call a rumour a release, and do not turn a blog post into a study.",
            "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=1080, height=1920\" />\n  <script src=\"gsap.min.js\"></script>\n  <style>\n    html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: #070a11; }\n    #digest-shell { position: relative; width: 1080px; height: 1920px; overflow: hidden; }\n  </style>\n</head>\n<body>\n  <div id=\"digest-shell\" data-composition-id=\"digest-shell\" data-start=\"0\" data-width=\"1080\" data-height=\"1920\">\n    <!-- nodecine:frames -->\n    <script>\n      const tl = gsap.timeline({ paused: true });\n      tl.set({}, {}, 1);\n      window.__timelines['digest-shell'] = tl;\n    </script>\n  </div>\n</body>\n</html>",
            "compositions/components/brand-corner.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"ui\" data-composition-variables=\"[]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"The mark and the film's name, in the corner of a scene.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.bc{position:absolute;inset:0;display:flex;align-items:center;gap:16px}.bc-label{color:#9fb4d4;font-size:22px;font-weight:850;letter-spacing:.14em}.bc-bug{display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:#5ee6a8;color:#06231a;font-size:31px;font-weight:1000;letter-spacing:-.1em}.bc-bug i{width:7px;height:7px;border-radius:50%;background:#06231a;margin-top:18px}</style>\n<div id=\"root\" data-composition-id=\"brand-corner\" data-duration=\"8\"><span class=\"bc\"><span class=\"bc-bug\">N<i></i></span><span class=\"bc-label\">TECH DIGEST</span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{}[key]:v[key])})});\n  \n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.bc'),{opacity:0,y:-12},{opacity:1,y:0,duration:.5,ease:'power2.out'},0);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['brand-corner']=tl;\n})();</script>\n</template></body></html>",
            "compositions/components/ticker-index.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"ui\" data-composition-variables=\"[]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"A numbered index of the items the film is about to show.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.ti{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;gap:18px}.ti-row{display:flex;align-items:center;gap:18px}.ti-no{color:#5ee6a8;font-size:24px;font-weight:850;letter-spacing:.1em}.ti-bar{flex:1;height:10px;border-radius:5px;background:#1c2b3d}.ti-row:first-child .ti-bar{background:#5ee6a866}.ti-row:last-child .ti-bar{width:60%}</style>\n<div id=\"root\" data-composition-id=\"ticker-index\" data-duration=\"8\"><span class=\"ti\"><span class=\"ti-row\"><span class=\"ti-no\">01</span><span class=\"ti-bar\"></span></span><span class=\"ti-row\"><span class=\"ti-no\">02</span><span class=\"ti-bar\"></span></span><span class=\"ti-row\"><span class=\"ti-no\">03</span><span class=\"ti-bar\"></span></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{}[key]:v[key])})});\n  \n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.ti-row'),{opacity:0,x:24,stagger:.09},{opacity:1,x:0,duration:.5,ease:'power2.out'},.3);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['ticker-index']=tl;\n})();</script>\n</template></body></html>",
            "compositions/components/source-chip.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"piece\" data-composition-variables=\"[{&quot;id&quot;:&quot;source&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;The source of this item&quot;,&quot;default&quot;:&quot;example.com&quot;,&quot;sample&quot;:&quot;example.com&quot;,&quot;maxLength&quot;:40,&quot;required&quot;:true}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"Where the item on screen came from, read from the scene's own source.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.sc{position:absolute;inset:0;display:flex;align-items:center;gap:18px;padding:16px 24px;border:1px solid #2b4468;border-radius:14px;background:#0c1526cc}.sc-tag{color:#5ee6a8;font-size:17px;font-weight:800;letter-spacing:.14em}.sc-source{flex:1;text-align:right;font-size:25px;color:#dbe6f5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}</style>\n<div id=\"root\" data-composition-id=\"source-chip\" data-duration=\"8\"><span class=\"sc\"><span class=\"sc-tag\">SOURCE</span><span class=\"sc-source\"></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"source\":\"example.com\"}[key]:v[key])})});\n  var chipEl=root.querySelector('.sc-source');if(chipEl)chipEl.textContent=String(v.source==null?'example.com':v.source);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.sc'),{y:14,opacity:0},{y:0,opacity:1,duration:.5,ease:'power2.out'},.8);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['source-chip']=tl;\n})();</script>\n</template></body></html>",
            "compositions/components/progress-rail.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"ui\" data-composition-variables=\"[{&quot;id&quot;:&quot;step&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Which scene this is&quot;,&quot;default&quot;:1,&quot;required&quot;:true},{&quot;id&quot;:&quot;total&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;How many scenes the film has&quot;,&quot;default&quot;:3,&quot;required&quot;:true}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"A running bar and count: which scene this is, of how many, from the scene's step and total.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.pr{position:absolute;inset:0;display:flex;align-items:center;gap:20px}.pr-rail{flex:1;height:8px;border-radius:4px;background:#1c2b3d;overflow:hidden}.pr-fill{display:block;height:100%;width:0;border-radius:4px;background:#5ee6a8}.pr-count{color:#8fa6c6;font-size:19px;font-weight:850;letter-spacing:.14em}</style>\n<div id=\"root\" data-composition-id=\"progress-rail\" data-duration=\"8\"><span class=\"pr\"><span class=\"pr-rail\"><span class=\"pr-fill\"></span></span><span class=\"pr-count\"></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"step\":1,\"total\":3}[key]:v[key])})});\n  var railEl=root.querySelector('.pr-fill');var stepN=Number(v.step)||1;var totalN=Math.max(1,Number(v.total)||1);if(railEl)railEl.style.width=Math.min(100,Math.round((stepN/totalN)*100))+'%';var countEl=root.querySelector('.pr-count');if(countEl)countEl.textContent=String(stepN).padStart(2,'0')+' / '+String(totalN).padStart(2,'0');\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.pr-fill'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.7,ease:'power2.out'},.2);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['progress-rail']=tl;\n})();</script>\n</template></body></html>"
