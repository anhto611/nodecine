crollHeight>el.clientHeight+2&&parseFloat(getComputedStyle(el).fontSize)>floor){el.style.fontSize=(parseFloat(getComputedStyle(el).fontSize)-2)+'px'}});\n  var ribEl=root.querySelector('.rb-source');if(ribEl)ribEl.textContent=String(v.source==null?'Chapter one':v.source);\n  var duration=Math.max(2,Number(v.seconds)||Number(root.dataset.duration)||4);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.book'),{y:70,opacity:0},{y:0,opacity:1,duration:.8,ease:'power3.out'},0)\n      .fromTo(q('.chapter-no'),{y:36,opacity:0},{y:0,opacity:1,duration:.6,ease:'power3.out'},.34)\n      .fromTo(q('.label'),{opacity:0},{opacity:1,duration:.5,ease:'sine.out'},.5)\n      .fromTo(q('.recto .title'),{y:44,opacity:0},{y:0,opacity:1,duration:.75,ease:'power3.out'},.46)\n      .fromTo(q('.recto .rule'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.55,ease:'power2.out'},.86)\n      .fromTo(q('.recto .detail'),{y:24,opacity:0},{y:0,opacity:1,duration:.6,ease:'power2.out'},.98)\n      .fromTo(q('.folio'),{opacity:0},{opacity:1,duration:.6,ease:'sine.out'},1.1)\n      tl.fromTo(q('.rh'),{opacity:0,y:-8},{opacity:1,y:0,duration:.5,ease:'power2.out'},0);\n      tl.fromTo(q('.rb'),{y:-60,opacity:0},{y:0,opacity:1,duration:.7,ease:'power3.out'},.3);\n  tl.set({},{},duration);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['book-chapter']=tl;\n})();</script>\n</template></body></html>",
            "compositions/book-close.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"4\" data-role=\"outro\" data-composition-variables=\"[{&quot;id&quot;:&quot;title&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;What to keep&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Điều nên giữ lại&quot;},&quot;default&quot;:&quot;What to keep&quot;,&quot;sample&quot;:&quot;Keep the argument, not the anecdote&quot;,&quot;maxLength&quot;:56,&quot;required&quot;:true},{&quot;id&quot;:&quot;detail&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;One sentence to close on&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Một câu kết&quot;},&quot;default&quot;:&quot;The one thing worth carrying out of this book.&quot;,&quot;sample&quot;:&quot;The book is at its best where it counts interruptions; its own stories prove less.&quot;,&quot;maxLength&quot;:160,&quot;required&quot;:true},{&quot;id&quot;:&quot;source&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;The book and its author&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Tên sách và tác giả&quot;},&quot;default&quot;:&quot;The book · its author&quot;,&quot;sample&quot;:&quot;Stolen Focus · Johann Hari&quot;,&quot;maxLength&quot;:60,&quot;required&quot;:true},{&quot;id&quot;:&quot;seconds&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Length in seconds (the Assemble node gives it)&quot;,&quot;default&quot;:4}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"Closing: what to keep, on the recto, with the book hanging over the edge.\" /></head>\n<body><template>\n<style>.book{position:absolute;left:90px;right:90px;top:300px;height:1320px;background:#f2ece0;color:#1b2320;border-radius:10px;box-shadow:0 60px 130px #02050499}.gutter{position:absolute;left:446px;top:0;bottom:0;width:8px;background:linear-gradient(90deg,#00000000,#00000024 45%,#00000000)}.verso{position:absolute;left:60px;width:330px;top:0;bottom:0}.recto{position:absolute;left:510px;right:70px;top:0;bottom:0}.slot-head{position:absolute;left:0;right:0;top:64px;height:74px}.slot-mark{position:absolute;right:-30px;top:-46px;width:62px;height:640px}.recto .title{position:absolute;left:0;right:0;margin:0;font-weight:850;letter-spacing:-.03em;overflow:hidden}.recto .rule{position:absolute;left:0;width:130px;height:8px;border-radius:8px;background:#b98c3f}.recto .detail{position:absolute;left:0;right:0;margin:0;color:#3c4a42;overflow:hidden}.folio{position:absolute;left:150px;right:150px;bottom:120px;display:flex;align-items:center;justify-content:space-between;color:#7d9a8b;font-size:18px;font-weight:800;letter-spacing:.18em}.label{position:absolute;left:0;color:#b98c3f;font-size:19px;font-weight:850;letter-spacing:.2em}.chapter-no{position:absolute;left:0;font-size:140px;line-height:1;font-weight:900;letter-spacing:-.05em;color:#1b2320}.close-mark{position:absolute;left:0;font-size:150px;line-height:1;color:#cbbfa6}.rh{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;gap:12px}.rh-title{color:#5d6b62;font-size:19px;font-weight:850;letter-spacing:.2em}.rh-rule{height:2px;background:#cbbfa6}.rb{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center}.rb-body{flex:1;width:100%;display:flex;flex-direction:column;align-items:center;gap:18px;padding:26px 0 0;background:#b98c3f;box-shadow:0 18px 40px #00000055}.rb-tail{width:100%;height:34px;background:#b98c3f;clip-path:polygon(0 0,100% 0,100% 100%,50% 62%,0 100%);margin-top:-1px}.rb-label{color:#2a1d08;font-size:14px;font-weight:850;letter-spacing:.18em;writing-mode:vertical-rl}.rb-source{color:#2a1d08;font-size:17px;font-weight:700;line-height:1.3;writing-mode:vertical-rl;max-height:420px;overflow:hidden}.close-mark{top:250px}.label{top:452px}.recto .title{top:246px;font-size:80px;line-height:1.1;max-height:620px}.recto .rule{top:950px}.recto .detail{top:1012px;font-size:38px;line-height:1.4;max-height:270px}</style>\n<div id=\"root\" data-composition-id=\"book-close\" data-duration=\"4\" data-width=\"1080\" data-height=\"1920\"><div class=\"nc-backdrop\"></div><div class=\"book\"><div class=\"gutter\"></div>\n        <div class=\"verso\"><span class=\"slot slot-head\"><span class=\"rh\"><span class=\"rh-title\">BOOK SUMMARY</span><span class=\"rh-rule\"></span></span></span><div class=\"close-mark\">§</div><span class=\"label\">WHAT TO KEEP</span></div>\n        <div class=\"recto\"><h1 class=\"title\"></h1><div class=\"rule\"></div><p class=\"detail\"></p></div>\n        <span class=\"slot slot-mark\"><span class=\"rb\"><span class=\"rb-body\"><span class=\"rb-label\">IN THE BOOK</span><span class=\"rb-source\"></span></span><span class=\"rb-tail\"></span></span></span>\n      </div>\n      <div class=\"folio\"><span>03 / CLOSE</span><span>NODECINE</span></div></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  ['title','detail','source'].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"title\":\"What to keep\",\"detail\":\"The one thing worth carrying out of this book.\",\"source\":\"The book · its author\",\"seconds\":4}[key]:v[key])})});\n  var number=root.querySelector('.number-value');if(number)number.textContent=String(v.number==null?'01':v.number).padStart(2,'0');\n  root.querySelectorAll('.title,.detail').forEach(function(el){var floor=el.classList.contains('title')?62:29;while(el.scrollHeight>el.clientHeight+2&&parseFloat(getComputedStyle(el).fontSize)>floor){el.style.fontSize=(parseFloat(getComputedStyle(el).fontSize)-2)+'px'}});\n  var ribEl=root.querySelector('.rb-source');if(ribEl)ribEl.textContent=String(v.source==null?'Chapter one':v.source);\n  var duration=Math.max(2,Number(v.seconds)||Number(root.dataset.duration)||4);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.book'),{y:70,opacity:0},{y:0,opacity:1,duration:.8,ease:'power3.out'},0)\n      .fromTo(q('.close-mark'),{scale:.7,opacity:0},{scale:1,opacity:1,duration:.7,ease:'back.out(1.4)'},.3)\n      .fromTo(q('.label'),{opacity:0},{opacity:1,duration:.5,ease:'sine.out'},.5)\n      .fromTo(q('.recto .title'),{y:44,opacity:0},{y:0,opacity:1,duration:.75,ease:'power3.out'},.44)\n      .fromTo(q('.recto .rule'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.55,ease:'power2.out'},.86)\n      .fromTo(q('.recto .detail'),{y:24,opacity:0},{y:0,opacity:1,duration:.6,ease:'power2.out'},.98)\n      .fromTo(q('.folio'),{opacity:0},{opacity:1,duration:.6,ease:'sine.out'},1.1)\n      tl.fromTo(q('.rh'),{opacity:0,y:-8},{opacity:1,y:0,duration:.5,ease:'power2.out'},0);\n      tl.fromTo(q('.rb'),{y:-60,opacity:0},{y:0,opacity:1,duration:.7,ease:'power3.out'},.3);\n  tl.set({},{},duration);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['book-close']=tl;\n})();</script>\n</template></body></html>",
            "storyboard-guide.md": "---\nfirst: hook\nlast: outro\nrepeat: 3\n---\nMake a summary of a book in English, vertical 9:16, about 80–100 seconds, set as an open spread: the verso carries the running head and the chapter's number, the recto carries the writing, and the bookmark down the outer edge carries where the passage sits.\nUse only what is in Research, the notes the person wrote and the URLs they gave. Never invent a quote, a page number or a figure.\nOpen with what the book gives a reader; one idea per chapter scene, in the book's own order; close with what to keep.\nEvery chapter scene carries a two-digit number in order (01, 02, 03), the idea in at most 56 characters, one sentence that explains it, and where it sits in the book (part, chapter or section, at most 48 characters).\nEvery scene carries a source: on the opening and closing scenes the book and its author, on a chapter where that chapter sits. The bookmark reads it.\nDrop an idea when Research has no support for it, and never present a summary of a summary as the book's own claim.",
            "compositions/components/running-head.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"ui\" data-composition-variables=\"[]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"The book's own name, set as a running head over a rule.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.rh{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;gap:12px}.rh-title{color:#5d6b62;font-size:19px;font-weight:850;letter-spacing:.2em}.rh-rule{height:2px;background:#cbbfa6}</style>\n<div id=\"root\" data-composition-id=\"running-head\" data-duration=\"8\"><span class=\"rh\"><span class=\"rh-title\">BOOK SUMMARY</span><span class=\"rh-rule\"></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{}[key]:v[key])})});\n  \n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.rh'),{opacity:0,y:-8},{opacity:1,y:0,duration:.5,ease:'power2.out'},0);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['running-head']=tl;\n})();</script>\n</template></body></html>",
            "compositions/components/ribbon.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"piece\" data-composition-variables=\"[{&quot;id&quot;:&quot;source&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;Where the passage sits in the book&quot;,&quot;default&quot;:&quot;Chapter one&quot;,&quot;sample&quot;:&quot;Part 2 � Chapter 4&quot;,&quot;maxLength&quot;:48,&quot;required&quot;:true}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"A bookmark over the page, carrying where the passage sits: reads the scene's own source.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.rb{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center}.rb-body{flex:1;width:100%;display:flex;flex-direction:column;align-items:center;gap:18px;padding:26px 0 0;background:#b98c3f;box-shadow:0 18px 40px #00000055}.rb-tail{width:100%;height:34px;background:#b98c3f;clip-path:polygon(0 0,100% 0,100% 100%,50% 62%,0 100%);margin-top:-1px}.rb-label{color:#2a1d08;font-size:14px;font-weight:850;letter-spacing:.18em;writing-mode:vertical-rl}.rb-source{color:#2a1d08;font-size:17px;font-weight:700;line-height:1.3;writing-mode:vertical-rl;max-height:420px;overflow:hidden}</style>\n<div id=\"root\" data-composition-id=\"ribbon\" data-duration=\"8\"><span class=\"rb\"><span class=\"rb-body\"><span class=\"rb-label\">IN THE BOOK</span><span class=\"rb-source\"></span></span><span class=\"rb-tail\"></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"source\":\"Chapter one\"}[key]:v[key])})});\n  var ribEl=root.querySelector('.rb-source');if(ribEl)ribEl.textContent=String(v.source==null?'Chapter one':v.source);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.rb'),{y:-60,opacity:0},{y:0,opacity:1,duration:.7,ease:'power3.out'},.3);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['ribbon']=tl;\n})();</script>\n</template></body></html>"
