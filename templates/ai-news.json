        }
      },
      {
        "id": "assembler",
        "type": "core/timeline-assembler",
        "params": {
          "fps": 30,
          "minTotalFrames": 300,
          "title": "AI news"
        },
        "bypassed": false,
        "position": {
          "x": 2020,
