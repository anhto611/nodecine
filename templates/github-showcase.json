      { "id": "tts-provider", "type": "core/tts-provider", "params": { "providerId": "system-tts", "settings": { "rate": 1 } }, "bypassed": false, "position": { "x": 320, "y": 900 } },
      { "id": "tts", "type": "core/tts-engine", "params": { "speed": 1 }, "bypassed": false, "position": { "x": 600, "y": 540 } },
