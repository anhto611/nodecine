                "source": "<style>\n  .hook { display: flex; flex-direction: column; align-items: flex-start; }\n  .hook .badge { display: inline-block; border: 2px solid var(--accent); color: var(--accent); background: color-mix(in srgb, var(--accent) 18%, transparent); border-radius: 999px; padding: 12px 28px; font: 700 26px/1 var(--font-body); letter-spacing: .18em; text-transform: uppercase; margin-bottom: 48px; }\n  .hook h1 { font: 800 88px/1.05 var(--font-display); text-transform: uppercase; letter-spacing: -0.01em; margin: 0; color: var(--fg); }\n  .hook p { font: 400 36px/1.35 var(--font-body); color: var(--muted); max-width: 760px; margin: 36px 0 0; }\n  .hook .stars { display: flex; align-items: center; gap: 20px; margin-top: 64px; background: rgba(255,255,255,.06); border: 2px solid rgba(255,255,255,.12); border-radius: 24px; padding: 22px 36px; }\n  .hook .stars svg { width: 48px; height: 48px; fill: #e3b341; }\n  .hook .stars b { font: 700 52px/1 var(--font-display); letter-spacing: .02em; color: var(--fg); }\n  .hook .stars span { font: 400 26px/1 var(--font-body); color: var(--muted); letter-spacing: .16em; text-transform: uppercase; }\n</style>\n<div class=\"hook\">\n  <div class=\"badge\" data-prop=\"badgeText\"></div>\n  <h1 data-prop=\"headline\"></h1>\n  <p data-prop=\"subline\"></p>\n  <div class=\"stars\" data-if=\"stars\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.6 22 9.6 17 14.5 18.2 21.5 12 18.2 5.8 21.5 7 14.5 2 9.6 8.91 8.6 12 2\"/></svg><b data-prop=\"stars\"></b><span>stars</span></div>\n</div>\n<script>\n  nodecine.timeline(gsap.timeline()\n    .fromTo(\".hook .badge\", { scale: 0 }, { scale: 1, duration: 0.5, ease: \"back.out(1.7)\" }, 0)\n    .fromTo(\".hook h1\", { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, ease: \"power3.out\" }, 0.25)\n    .fromTo(\".hook p\", { opacity: 0 }, { opacity: 1, duration: 0.5 }, 0.6)\n    .fromTo(\".hook .stars\", { scale: 0.6, opacity: 0 }, { scale: 1, opacity: 1, duration: