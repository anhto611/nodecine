{
  "id": "github-showcase",
  "name": { "en": "GitHub Repo Showcase", "vi": "GitHub Repo Showcase" },
  "description": { "en": "Turn a repo link into a 9:16 terminal-style video. Stars and the install command come from GitHub, not from the model.", "vi": "Biến link repo thành video dọc 9:16 phong cách terminal. Số sao và lệnh cài lấy từ GitHub, không qua mô hình." },
  "category": "tech",
  "graph": {
