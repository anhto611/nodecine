ation: 0.6, ease: \"power3.out\" }, 0)\n    .fromTo(\".mock .win\", { scale: 0.94, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: \"power3.out\" }, 0.2)\n    .fromTo(\".mock .cmd\", { opacity: 0 }, { opacity: 1, duration: 0.3 }, 0.6)\n    .fromTo(\".mock li\", { x: 24, opacity: 0 }, { x: 0, opacity: 1, duration: 0.45, stagger: 0.3, ease: \"power2.out\" }, 0.9)\n    .fromTo(\".mock .foot\", { opacity: 0 }, { opacity: 1, duration: 0.4 }, 1.8));\n</script>"
