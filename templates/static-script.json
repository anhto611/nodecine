        "target": "output",
        "targetPort": "ir"
      },
      {
        "id": "e6",
        "source": "assembler",
        "sourcePort": "ir",
        "target": "export",
        "targetPort": "ir"
      },
      {
        "id": "e7",
        "source": "engine",
        "sourcePort": "engine",
        "target": "output",
        "targetPort": "engine"
      },
      {
        "id": "e8",
