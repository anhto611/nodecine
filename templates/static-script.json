{
  "id": "static-script",
  "name": {
    "en": "Static Script",
    "vi": "Kịch Bản Tĩnh"
  },
  "description": {
    "en": "Hand-written script and scenes on a dark stage with one text block. Nine core nodes, no network.",
    "vi": "Gõ tay lời thoại và cảnh trên stage tối với một block chữ. Chín node lõi, không mạng."
  },
  "category": "core",
  "graph": {
    "nodes": [
      {
        "id": "stage",
        "type": "core/stage",
        "params": {
          "id": "dark",
          "name": "Dark",
          "tokens": {
            "palette": {
              "bg": "#0b0c10",
              "bg2": "#101218",
              "panel": "#14161c",
              "line": "#2a2e37",
              "fg": "#f2f3f5",
              "muted": "#9aa0ab",
              "muted2": "#5f6570",
              "accent": "#7c5cff"
            },
            "fonts": {
              "display": "'JetBrains Mono', ui-monospace, Menlo, monospace",
              "body": "'JetBrains Mono', ui-monospace, Menlo, monospace"
            }
          },
          "tones": {
            "cool": {
              "accent": "#58a6ff",
              "bg2": "#0f1420"
            },
            "warm": {
              "accent": "#e3b341",
              "bg2": "#1a150e"
            },
            "green": {
              "accent": "#3fb950",
              "bg2": "#0e1a12"
            }
          },
          "sceneFields": [
            {
              "name": "kicker",
              "rule": "two or three words naming what the scene is about, uppercase, shown small above the content"
            }
          ],
          "code": {
            "format": "html-gsap",
            "source": "<style>\n  .stage { position: absolute; inset: 0; background: radial-gradient(120% 80% at 50% 0%, var(--bg2) 0%, var(--bg) 65%); color: var(--fg); font-family: var(--font-body); }\n  .stage .kicker { position: absolute; left: 72px; top: 200px; font: 600 28px/1 var(--font-body); letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }\n  .stage .content { position: absolute; left: 72px; right: 168px; top: 260px; bottom: 680px; display: flex; flex-direction: column; justify-content: center; }\n  .stage .rule { position: absolute; left: 72px; right: 168px; bottom: 640px; height: 2px; background: var(--line); }\n</style>\n<div class=\"stage\">\n  <div class=\"kicker\" data-field=\"kicker\"></div>\n  <div class=\"content\" data-slot=\"content\"></div>\n  <div class=\"rule\"></div>\n</div>\n<script>\n  nodecine.timeline(gsap.timeline()\n    .fromTo(\".kicker\", { opacity: 0, x: -16 }, { opacity: 1, x: 0, duration: 0.4, ease: \"power2.out\" }, 0)\n    .fromTo(\".rule\", { scaleX: 0, transformOrigin: \"left center\" }, { scaleX: 1, duration: 0.6, ease: \"power2.out\" }, 0.1));\n</script>"
          }
        },
        "bypassed": false,
        "position": {
          "x": 50,
          "y": 40
        }
      },
      {
        "id": "blocks",
        "type": "core/blocks",
        "params": {
          "blocks": [
            {
              "id": "text-card",
              "name": "Text card",
              "doc": {
                "example": "{\"headline\":\"Ship video from a graph\",\"body\":\"Wire a source to a script, a voice and an engine.\"}",
                "when": "One idea on screen: a headline and at most one supporting line. Use it for openings, transitions and closings; not for lists or numbers."
              },
              "props": {
                "headline": {
                  "type": "string",
                  "hint": "up to six words, title case",
                  "required": true,
                  "max": 60
                },
                "body": {
                  "type": "text",
                  "hint": "one sentence, or leave it out",
                  "required": false,
                  "max": 160
                }
              },
              "code": {
                "format": "html-gsap",
                "source": "<style>\n  .card { display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: 32px; }\n  .card h1 { font: 800 88px/1.05 var(--font-display); color: var(--fg); margin: 0; letter-spacing: -0.01em; }\n  .card p  { font: 400 38px/1.4 var(--font-body); color: var(--muted); margin: 0; max-width: 760px; }\n  .card .bar { width: 120px; height: 10px; border-radius: 5px; background: var(--accent); transform-origin: left center; }\n</style>\n<div class=\"card\">\n  <div class=\"bar\"></div>\n  <h1 data-prop=\"headline\"></h1>\n  <p data-prop=\"body\" data-if=\"body\"></p>\n</div>\n<script>\n  nodecine.timeline(gsap.timeline()\n    .fromTo(\".card .bar\", { scaleX: 0 }, { scaleX: 1, duration: 0.4, ease: \"power2.out\" }, 0)\n    .fromTo(\".card h1\", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: \"power3.out\" }, 0.2)\n    .fromTo(\".card p\", { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: \"power3.out\" }, 0.5));\n</script>"
              }
            }
          ]
        },
        "bypassed": false,
        "position": {
          "x": 50,
          "y": 380
        }
      },
      {
        "id": "script",
        "type": "core/static-script",
        "params": {
          "script": "Meet NodeCine. Build short videos from a node graph, not a timeline. Wire a source to a script, a voice, and an engine, and press run.",
          "scenes": [
            {
              "blockId": "text-card",
              "weight": 1,
              "props": {
                "headline": "Ship video from a graph",
                "body": "NodeCine v0.1"
              },
              "fields": {
                "kicker": "NodeCine"
              }
            },
            {
              "blockId": "text-card",
              "weight": 2,
              "props": {
                "headline": "Nodes, not timelines"
              },
              "tone": "cool",
              "fields": {
                "kicker": "How"
              }
            },
            {
              "blockId": "text-card",
              "weight": 1,
              "props": {
                "headline": "Star on GitHub"
              },
              "tone": "warm",
              "fields": {
                "kicker": "Next"
              }
            }
          ]
        },
        "bypassed": false,
        "position": {
          "x": 410,
          "y": 220
        }
      },
      {
        "id": "tts-provider",
        "type": "core/tts-provider",
        "params": {
          "providerId": "system-tts",
          "settings": {
            "rate": 1
          }
        },
        "bypassed": false,
        "position": {
          "x": 720,
          "y": 580
        }
      },
      {
        "id": "tts",
        "type": "core/tts-engine",
        "params": {
          "speed": 1
        },
        "bypassed": false,
        "position": {
          "x": 970,
          "y": 430
        }
      },
      {
        "id": "assembler",
        "type": "core/timeline-assembler",
        "params": {
          "fps": 30,
          "width": 1080,
          "height": 1920,
          "minTotalFrames": 270,
          "title": "Static script"
        },
        "bypassed": false,
        "position": {
          "x": 1230,
          "y": 220
        }
      },
      {
        "id": "engine",
        "type": "core/hyperframes-engine",
        "params": {},
        "bypassed": false,
        "position": {
          "x": 970,
          "y": 670
        }
      },
      {
        "id": "output",
        "type": "core/video-output",
        "params": {},
        "bypassed": false,
        "position": {
          "x": 1600,
          "y": 70
        }
      },
      {
        "id": "export",
        "type": "core/mp4-export",
        "params": {
          "codec": "h264",
          "quality": "high",
          "fileName": "static-script.mp4"
        },
        "bypassed": true,
        "position": {
          "x": 1600,
          "y": 870
        }
      }
    ],
    "edges": [
      {
