{
  "id": "article-summary",
  "name": {
    "vi": "Tóm tắt bài viết / trang web",
    "en": "Article / website summary"
  },
  "description": {
    "vi": "Dán URL nguồn vào Brief, dùng LLM nghiên cứu và viết kịch bản, tạo giọng đọc và video dọc 9:16.",
    "en": "Paste a source URL into Brief to research the article, write a script, narrate it, and create a vertical 9:16 video."
  },
  "category": "mine",
