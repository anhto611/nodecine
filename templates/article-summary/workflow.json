'),{opacity:0,x:16},{opacity:1,x:0,duration:.6,ease:'power2.out'},.7);\n  tl.set({},{},duration);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['summary-hook']=tl;\n})();</script>\n</template></body></html>",
