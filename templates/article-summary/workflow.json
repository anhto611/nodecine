            "compositions/summary-close.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"4\" data-role=\"outro\" data-composition-variables=\"[{&quot;id&quot;:&quot;title&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;Short, source-supported headline&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Tiêu đề ngắn có căn cứ từ nguồn&quot;},&quot;default&quot;:&quot;What to remember&quot;,&quot;sample&quot;:&quot;Understand it before you share it&quot;,&quot;maxLength&quot;:40,&quot;required&quot;:true},{&quot;id&quot;:&quot;detail&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;One clear explanatory sentence grounded in the source&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Một câu giải thích dựa trên bài gốc&quot;},&quot;default&quot;:&quot;The key point, explained briefly from the article.&quot;,&quot;sample&quot;:&quot;The summary gives you the point; the original gives you the context.&quot;,&quot;maxLength&quot;:94,&quot;required&quot;:true},{&quot;id&quot;:&quot;source&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;Short name or domain of the source article&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Tên ngắn hoặc tên miền của nguồn&quot;},&quot;default&quot;:&quot;THE ORIGINAL ARTICLE&quot;,&quot;sample&quot;:&quot;THE ORIGINAL ARTICLE&quot;,&quot;maxLength&quot;:48,&quot;required&quot;:true},{&quot;id&quot;:&quot;seconds&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Length in seconds (the Assemble node gives it)&quot;,&quot;default&quot;:4}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"Final source-supported takeaway; concise synthesis without an invented call to action.\" /></head>\n<body><template>\n<style>html,body{margin:0;background:#081220}*{box-sizing:border-box}#root{position:absolute;inset:0;width:1080px;height:1920px;overflow:hidden;color:#f4f8fb;background:#081220;font-family:var(--font-body,Inter,Arial,sans-serif)}.nc-bac