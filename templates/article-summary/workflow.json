        "bypassed": false,
        "position": {
          "x": 0,
          "y": 120
        },
        "version": 1
      },
      {
        "id": "research",
        "type": "research",
        "params": {
          "search": "sources",
          "guide": "Read the URLs in the Brief. Pull the 3–5 most important points and keep the source URL for each. Say plainly what could not be read; never fill a gap with a guess.",
          "llmProvider": "",
          "llmSettings": {},
          "attempt": 0,
          "edits": {}
        },
        "bypassed": false,
        "position": {
          "x": 300,
          "y": 100
        },
