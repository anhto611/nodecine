        "params": {
          "search": "sources",
          "guide": "Read the URLs and the tables in the Brief. Keep each figure as the source prints it, with its unit, its year and where it came from, and keep the sentence that says what it measures. Say plainly what could not be read; never estimate a figure the source does not state.",
          "llmProvider": "",
          "llmSettings": {},
