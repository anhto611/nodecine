        "params": {
          "files": {
            "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=1080, height=1920\" />\n  <script src=\"gsap.min.js\"></script>\n  <style>\n    html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: #0a0a10; }\n    #data-shell { position: relative; width: 1080px; height: 1920px; overflow: hidden; }\n  </style>\n</head>\n<body>\n  <div id=\"data-shell\" data-composition-id=\"data-shell\" data-start=\"0\" data-width=\"1080\" data-height=\"1920\">\n    <!-- nodecine:frames -->\n    <script>\n      const tl = gsap.timeline({ paused: true });\n      tl.set({}, {}, 1);\n      window.__timelines['data-shell'] = tl;\n    </script>\n  </div>\n</body>\n</html>",
            "compositions/data-open.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"4\" data-role=\"hook\" data-composition-variables=\"[{&quot;id&quot;:&quot;title&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;The question the story answers&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Câu hỏi mà mạch chuyện trả lời&quot;},&quot;default&quot;:&quot;What the numbers say&quot;,&quot;sample&quot;:&quot;Where the money actually goes&quot;,&quot;maxLength&quot;:56,&quot;required&quot;:true},{&quot;id&quot;:&quot;detail&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;One sentence on why it matters&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Một câu vì sao đáng quan tâm&quot;},&quot;default&quot;:&quot;Why this question is worth a minute.&quot;,&quot;sample&quot;:&quot;Three figures, one table, and a conclusion most coverage skips.&quot;,&quot;maxLength&quot;:150,&quot;required&quot;:true},{&quot;id&quot;:&quot;source&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;Where the figures come from&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Nguồn của các con số&quot;},&quot;default&quot;:&quot;the report&quot;,&quot;sample&quot;:&quot;Office for Budget Responsibility, 2024&quot;,&quot;maxLength&quot;:48,&quot;required&quot;:true},{&quot;id&quot;:&quot;seconds&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Length in seconds (the Assemble node gives it)&quot;,&quot;default&quot;:4}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"Opening: the question the numbers answer, under a mark that runs off the edge.\" /></head>\n<body><template>\n<style>html,body{margin:0;background:#0a0a10}*{box-sizing:border-box}#root{position:absolute;inset:0;width:1080px;height:1920px;overflow:hidden;color:#f2f2f7;background:#0a0a10;font-family:var(--font-body,Inter,Arial,sans-serif)}.nc-backdrop{position:absolute;inset:0;background:radial-gradient(circle at 80% 6%,#241f4a 0,#12101f 54%,#08080e 100%)}.dots{position:absolute;inset:0;background-image:radial-gradient(#ffffff12 1.5px,transparent 1.5px);background-size:44px 44px}.slot-poster{position:absolute;left:-40px;right:80px;top:196px;height:404px}.slot-axis{position:absolute;left:150px;right:150px;top:704px;height:92px}.slot-source{position:absolute;left:110px;right:110px;bottom:118px;height:56px}.stamp{position:absolute;z-index:3;left:110px;top:108px;color:#8b93b8;font-size:17px;font-weight:800;letter-spacing:.2em}.body{position:absolute;left:110px;right:130px}.body .hair{position:absolute;left:0;right:0;height:1px;background:#2b2650}.mark{position:absolute;left:-60px;font-size:560px;line-height:1;font-weight:900;color:#241f4a}.sl{position:absolute;inset:0;display:flex;align-items:center;gap:22px}.sl-line{flex:none;width:120px;height:1px;background:#2b2650}.sl-label{color:#ff8f7a;font-size:16px;font-weight:850;letter-spacing:.18em}.sl-source{flex:1;text-align:right;color:#8b93b8;font-size:22px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.open .mark{top:120px}.open .title{position:absolute;left:0;right:0;top:716px;margin:0;font-size:96px;line-height:1.06;letter-spacing:-.035em;font-weight:850;max-height:560px;overflow:hidden}.open .hair{top:1330px}.open .detail{position:absolute;left:0;right:0;top:1392px;margin:0;font-size:38px;line-height:1.36;color:#c9c4e4;max-height:260px;overflow:hidden}</style>\n<div id=\"root\" data-composition-id=\"data-open\" data-duration=\"4\" data-width=\"1080\" data-height=\"1920\"><div class=\"nc-backdrop\"></div><div class=\"dots\"></div>\n      <span class=\"stamp\">DATA STORY / 01</span>\n      <div class=\"mark\">?</div>\n      <div class=\"body open\"><h1 class=\"title\"></h1><div class=\"hair\"></div><p class=\"detail\"></p></div>\n      <span class=\"slot slot-source\"><span class=\"sl\"><span class=\"sl-line\"></span><span class=\"sl-label\">WHERE IT COMES FROM</span><span class=\"sl-source\"></span></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  ['title','detail','source'].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"title\":\"What the numbers say\",\"detail\":\"Why this question is worth a minute.\",\"source\":\"the report\",\"seconds\":4}[key]:v[key])})});\n  var number=root.querySelector('.number-value');if(number)number.textContent=String(v.number==null?'01':v.number).padStart(2,'0');\n  root.querySelectorAll('.title,.detail').forEach(function(el){var floor=el.classList.contains('title')?62:29;while(el.scrollHeight>el.clientHeight+2&&parseFloat(getComputedStyle(el).fontSize)>floor){el.style.fontSize=(parseFloat(getComputedStyle(el).fontSize)-2)+'px'}});\n  var srcEl=root.querySelector('.sl-source');if(srcEl)srcEl.textContent=String(v.source==null?'the report':v.source);\n  var duration=Math.max(2,Number(v.seconds)||Number(root.dataset.duration)||4);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.dots'),{opacity:0},{opacity:1,duration:1,ease:'sine.out'},0)\n      .fromTo(q('.mark'),{x:-80,opacity:0},{x:0,opacity:1,duration:.9,ease:'power3.out'},.06)\n      .fromTo(q('.open .title'),{y:54,opacity:0},{y:0,opacity:1,duration:.8,ease:'power3.out'},.34)\n      .fromTo(q('.open .hair'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.6,ease:'power2.out'},.78)\n      .fromTo(q('.open .detail'),{y:26,opacity:0},{y:0,opacity:1,duration:.6,ease:'power2.out'},.9)\n      tl.fromTo(q('.sl'),{opacity:0,y:10},{opacity:1,y:0,duration:.5,ease:'power2.out'},1.05);\n  tl.set({},{},duration);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['data-open']=tl;\n})();</script>\n</template></body></html>",
            "compositions/data-chart.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"4\" data-role=\"feature\" data-composition-variables=\"[{&quot;id&quot;:&quot;figure&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;The figure, as the source prints it&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Con số, đúng như nguồn in&quot;},&quot;default&quot;:&quot;62%&quot;,&quot;sample&quot;:&quot;62%&quot;,&quot;maxLength&quot;:12,&quot;required&quot;:true},{&quot;id&quot;:&quot;share&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;How much of the whole it is, from 0 to 1&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Nó chiếm bao nhiêu phần của tổng, từ 0 đến 1&quot;},&quot;default&quot;:0.62,&quot;sample&quot;:0.62},{&quot;id&quot;:&quot;title&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;The claim&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Nhận định&quot;},&quot;default&quot;:&quot;What the figure means&quot;,&quot;sample&quot;:&quot;Most of it is spent before the year starts&quot;,&quot;maxLength&quot;:56,&quot;required&quot;:true},{&quot;id&quot;:&quot;detail&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;One sentence that explains it&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Một câu giải thích&quot;},&quot;default&quot;:&quot;What it measures, in one sentence.&quot;,&quot;sample&quot;:&quot;The figure counts households, not people, so a city of renters weighs less than it looks.&quot;,&quot;maxLength&quot;:170,&quot;required&quot;:true},{&quot;id&quot;:&quot;source&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;Where the figure came from&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Nguồn của con số&quot;},&quot;default&quot;:&quot;the report&quot;,&quot;sample&quot;:&quot;Office for Budget Responsibility, 2024&quot;,&quot;maxLength&quot;:48,&quot;required&quot;:true},{&quot;id&quot;:&quot;seconds&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Length in seconds (the Assemble node gives it)&quot;,&quot;default&quot;:4}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"One claim: the figure running off the edge, a scale under it, and where it came from.\" /></head>\n<body><template>\n<style>html,body{margin:0;background:#0a0a10}*{box-sizing:border-box}#root{position:absolute;inset:0;width:1080px;height:1920px;overflow:hidden;color:#f2f2f7;background:#0a0a10;font-family:var(--font-body,Inter,Arial,sans-serif)}.nc-backdrop{position:absolute;inset:0;background:radial-gradient(circle at 80% 6%,#241f4a 0,#12101f 54%,#08080e 100%)}.dots{position:absolute;inset:0;background-image:radial-gradient(#ffffff12 1.5px,transparent 1.5px);background-size:44px 44px}.slot-poster{position:absolute;left:-40px;right:80px;top:196px;height:404px}.slot-axis{position:absolute;left:150px;right:150px;top:704px;height:92px}.slot-source{position:absolute;left:110px;right:110px;bottom:118px;height:56px}.stamp{position:absolute;z-index:3;left:110px;top:108px;color:#8b93b8;font-size:17px;font-weight:800;letter-spacing:.2em}.body{position:absolute;left:110px;right:130px}.body .hair{position:absolute;left:0;right:0;height:1px;background:#2b2650}.mark{position:absolute;left:-60px;font-size:560px;line-height:1;font-weight:900;color:#241f4a}.sp{position:absolute;inset:0;display:flex;align-items:flex-start}.sp-figure{margin:0;font-size:420px;line-height:.86;font-weight:900;letter-spacing:-.06em;color:#ff8f7a;white-space:nowrap}.ax{position:absolute;inset:0}.ax-line{position:absolute;left:0;right:0;top:36px;height:2px;background:#2b2650}.ax-tick{position:absolute;top:36px}.ax-tick i{position:absolute;left:0;top:0;width:2px;height:18px;background:#2b2650}.ax-tick b{position:absolute;left:0;top:26px;transform:translateX(-50%);color:#8b93b8;font-size:17px;font-weight:750;letter-spacing:.08em}.ax-mark{position:absolute;left:0;top:8px;width:6px;height:58px;border-radius:3px;background:#ff8f7a;transform:translateX(-50%)}.sl{position:absolute;inset:0;display:flex;align-items:center;gap:22px}.sl-line{flex:none;width:120px;height:1px;background:#2b2650}.sl-label{color:#ff8f7a;font-size:16px;font-weight:850;letter-spacing:.18em}.sl-source{flex:1;text-align:right;color:#8b93b8;font-size:22px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chart .title{position:absolute;left:0;right:0;top:996px;margin:0;font-size:84px;line-height:1.08;letter-spacing:-.03em;font-weight:850;max-height:420px;overflow:hidden}.chart .hair{top:1476px}.chart .detail{position:absolute;left:0;right:0;top:1538px;margin:0;font-size:36px;line-height:1.36;color:#c9c4e4;max-height:240px;overflow:hidden}</style>\n<div id=\"root\" data-composition-id=\"data-chart\" data-duration=\"4\" data-width=\"1080\" data-height=\"1920\"><div class=\"nc-backdrop\"></div><div class=\"dots\"></div>\n      <span class=\"stamp\">DATA STORY / 02</span>\n      <span class=\"slot slot-poster\"><span class=\"sp\"><span class=\"sp-figure\"></span></span></span>\n      <span class=\"slot slot-axis\"><span class=\"ax\"><span class=\"ax-line\"></span><span class=\"ax-tick\" style=\"left:0%\"><i></i><b>0</b></span><span class=\"ax-tick\" style=\"left:25%\"><i></i><b>25</b></span><span class=\"ax-tick\" style=\"left:50%\"><i></i><b>50</b></span><span class=\"ax-tick\" style=\"left:75%\"><i></i><b>75</b></span><span class=\"ax-tick\" style=\"left:100%\"><i></i><b>100</b></span><span class=\"ax-mark\"></span></span></span>\n      <div class=\"body chart\"><h1 class=\"title\"></h1><div class=\"hair\"></div><p class=\"detail\"></p></div>\n      <span class=\"slot slot-source\"><span class=\"sl\"><span class=\"sl-line\"></span><span class=\"sl-label\">WHERE IT COMES FROM</span><span class=\"sl-source\"></span></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  ['title','detail','source'].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"figure\":\"62%\",\"share\":0.62,\"title\":\"What the figure means\",\"detail\":\"What it measures, in one sentence.\",\"source\":\"the report\",\"seconds\":4}[key]:v[key])})});\n  var number=root.querySelector('.number-value');if(number)number.textContent=String(v.number==null?'01':v.number).padStart(2,'0');\n  root.querySelectorAll('.title,.detail').forEach(function(el){var floor=el.classList.contains('title')?62:29;while(el.scrollHeight>el.clientHeight+2&&parseFloat(getComputedStyle(el).fontSize)>floor){el.style.fontSize=(parseFloat(getComputedStyle(el).fontSize)-2)+'px'}});\n  var figEl=root.querySelector('.sp-figure');if(figEl)figEl.textContent=String(v.figure==null?'62%':v.figure);\n  var markEl=root.querySelector('.ax-mark');var shareN=Math.max(0,Math.min(1,Number(v.share)||0));if(markEl)markEl.style.left=(shareN*100)+'%';\n  var srcEl=root.querySelector('.sl-source');if(srcEl)srcEl.textContent=String(v.source==null?'the report':v.source);\n  var duration=Math.max(2,Number(v.seconds)||Number(root.dataset.duration)||4);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.dots'),{opacity:0},{opacity:1,duration:1,ease:'sine.out'},0)\n      .fromTo(q('.chart .title'),{y:48,opacity:0},{y:0,opacity:1,duration:.75,ease:'power3.out'},.55)\n      .fromTo(q('.chart .hair'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.6,ease:'power2.out'},.9)\n      .fromTo(q('.chart .detail'),{y:26,opacity:0},{y:0,opacity:1,duration:.6,ease:'power2.out'},1)\n      tl.fromTo(q('.sp-figure'),{x:-70,opacity:0},{x:0,opacity:1,duration:.85,ease:'power3.out'},0);\n      tl.fromTo(q('.ax'),{opacity:0},{opacity:1,duration:.5,ease:'sine.out'},.5)\n      .fromTo(q('.ax-mark'),{scaleY:0,transformOrigin:'bottom center'},{scaleY:1,duration:.5,ease:'power2.out'},.72);\n      tl.fromTo(q('.sl'),{opacity:0,y:10},{opacity:1,y:0,duration:.5,ease:'power2.out'},1.05);\n  tl.set({},{},duration);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['data-chart']=tl;\n})();</script>\n</template></body></html>",
            "compositions/data-close.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"4\" data-role=\"outro\" data-composition-variables=\"[{&quot;id&quot;:&quot;title&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;What the figures mean together&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Các con số cùng nói lên điều gì&quot;},&quot;default&quot;:&quot;What it means&quot;,&quot;sample&quot;:&quot;The headline number was the least interesting one&quot;,&quot;maxLength&quot;:56,&quot;required&quot;:true},{&quot;id&quot;:&quot;detail&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;One sentence to close on&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Một câu kết&quot;},&quot;default&quot;:&quot;The one thing the numbers say together.&quot;,&quot;sample&quot;:&quot;Two of the three figures move together; the third is the one to watch next year.&quot;,&quot;maxLength&quot;:160,&quot;required&quot;:true},{&quot;id&quot;:&quot;source&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;Where the figures come from&quot;,&quot;labels&quot;:{&quot;vi&quot;:&quot;Nguồn của các con số&quot;},&quot;default&quot;:&quot;the report&quot;,&quot;sample&quot;:&quot;Office for Budget Responsibility, 2024&quot;,&quot;maxLength&quot;:48,&quot;required&quot;:true},{&quot;id&quot;:&quot;seconds&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Length in seconds (the Assemble node gives it)&quot;,&quot;default&quot;:4}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"Closing: what the figures mean together, under a sum that runs off the edge.\" /></head>\n<body><template>\n<style>html,body{margin:0;background:#0a0a10}*{box-sizing:border-box}#root{position:absolute;inset:0;width:1080px;height:1920px;overflow:hidden;color:#f2f2f7;background:#0a0a10;font-family:var(--font-body,Inter,Arial,sans-serif)}.nc-backdrop{position:absolute;inset:0;background:radial-gradient(circle at 80% 6%,#241f4a 0,#12101f 54%,#08080e 100%)}.dots{position:absolute;inset:0;background-image:radial-gradient(#ffffff12 1.5px,transparent 1.5px);background-size:44px 44px}.slot-poster{position:absolute;left:-40px;right:80px;top:196px;height:404px}.slot-axis{position:absolute;left:150px;right:150px;top:704px;height:92px}.slot-source{position:absolute;left:110px;right:110px;bottom:118px;height:56px}.stamp{position:absolute;z-index:3;left:110px;top:108px;color:#8b93b8;font-size:17px;font-weight:800;letter-spacing:.2em}.body{position:absolute;left:110px;right:130px}.body .hair{position:absolute;left:0;right:0;height:1px;background:#2b2650}.mark{position:absolute;left:-60px;font-size:560px;line-height:1;font-weight:900;color:#241f4a}.sl{position:absolute;inset:0;display:flex;align-items:center;gap:22px}.sl-line{flex:none;width:120px;height:1px;background:#2b2650}.sl-label{color:#ff8f7a;font-size:16px;font-weight:850;letter-spacing:.18em}.sl-source{flex:1;text-align:right;color:#8b93b8;font-size:22px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.close .mark{top:120px}.close .title{position:absolute;left:0;right:0;top:716px;margin:0;font-size:100px;line-height:1.06;letter-spacing:-.035em;font-weight:850;max-height:560px;overflow:hidden}.close .hair{top:1330px}.close .detail{position:absolute;left:0;right:0;top:1392px;margin:0;font-size:40px;line-height:1.36;color:#c9c4e4;max-height:260px;overflow:hidden}</style>\n<div id=\"root\" data-composition-id=\"data-close\" data-duration=\"4\" data-width=\"1080\" data-height=\"1920\"><div class=\"nc-backdrop\"></div><div class=\"dots\"></div>\n      <span class=\"stamp\">DATA STORY / 03</span>\n      <div class=\"mark\">∑</div>\n      <div class=\"body close\"><h1 class=\"title\"></h1><div class=\"hair\"></div><p class=\"detail\"></p></div>\n      <span class=\"slot slot-source\"><span class=\"sl\"><span class=\"sl-line\"></span><span class=\"sl-label\">WHERE IT COMES FROM</span><span class=\"sl-source\"></span></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  ['title','detail','source'].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"title\":\"What it means\",\"detail\":\"The one thing the numbers say together.\",\"source\":\"the report\",\"seconds\":4}[key]:v[key])})});\n  var number=root.querySelector('.number-value');if(number)number.textContent=String(v.number==null?'01':v.number).padStart(2,'0');\n  root.querySelectorAll('.title,.detail').forEach(function(el){var floor=el.classList.contains('title')?62:29;while(el.scrollHeight>el.clientHeight+2&&parseFloat(getComputedStyle(el).fontSize)>floor){el.style.fontSize=(parseFloat(getComputedStyle(el).fontSize)-2)+'px'}});\n  var srcEl=root.querySelector('.sl-source');if(srcEl)srcEl.textContent=String(v.source==null?'the report':v.source);\n  var duration=Math.max(2,Number(v.seconds)||Number(root.dataset.duration)||4);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.dots'),{opacity:0},{opacity:1,duration:1,ease:'sine.out'},0)\n      .fromTo(q('.mark'),{x:-80,opacity:0},{x:0,opacity:1,duration:.9,ease:'power3.out'},.06)\n      .fromTo(q('.close .title'),{y:54,opacity:0},{y:0,opacity:1,duration:.8,ease:'power3.out'},.32)\n      .fromTo(q('.close .hair'),{scaleX:0,transformOrigin:'left center'},{scaleX:1,duration:.6,ease:'power2.out'},.76)\n      .fromTo(q('.close .detail'),{y:26,opacity:0},{y:0,opacity:1,duration:.6,ease:'power2.out'},.88)\n      tl.fromTo(q('.sl'),{opacity:0,y:10},{opacity:1,y:0,duration:.5,ease:'power2.out'},1.05);\n  tl.set({},{},duration);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['data-close']=tl;\n})();</script>\n</template></body></html>",
            "storyboard-guide.md": "---\nfirst: hook\nlast: outro\nrepeat: 3\n---\nMake a story told with numbers in English, vertical 9:16, about 65–85 seconds, set as a poster: the figure runs off the left edge, a scale sits under it with a marker where the figure falls, the claim runs across the lower third, and a fine line at the foot says where the number came from.\nUse only the figures Research kept, each with the source's own wording, unit and year. Never invent, extrapolate or round a figure in a way that changes what it says.\nOpen with the question the story answers; one claim per scene; close with what the figures mean together.\nEvery claim scene carries the figure as the source prints it (at most 12 characters including its unit), the share of the whole it represents as a number between 0 and 1 when the source gives one (use 0 when it does not), the claim in at most 56 characters, one sentence that explains it, and where the figure came from (at most 48 characters).\nEvery scene carries a source: the report, table or page the figures come from, at most 48 characters.\nSay what a figure measures, not only how big it is: \"62% of adults\" is a claim, \"62%\" is not.",
            "compositions/components/stat-poster.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"piece\" data-composition-variables=\"[{&quot;id&quot;:&quot;figure&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;The figure, as the source prints it&quot;,&quot;default&quot;:&quot;62%&quot;,&quot;sample&quot;:&quot;62%&quot;,&quot;maxLength&quot;:12,&quot;required&quot;:true}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"The figure the scene turns on, set at poster size: reads the scene's own figure.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.sp{position:absolute;inset:0;display:flex;align-items:flex-start}.sp-figure{margin:0;font-size:420px;line-height:.86;font-weight:900;letter-spacing:-.06em;color:#ff8f7a;white-space:nowrap}</style>\n<div id=\"root\" data-composition-id=\"stat-poster\" data-duration=\"8\"><span class=\"sp\"><span class=\"sp-figure\"></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"figure\":\"62%\"}[key]:v[key])})});\n  var figEl=root.querySelector('.sp-figure');if(figEl)figEl.textContent=String(v.figure==null?'62%':v.figure);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.sp-figure'),{x:-70,opacity:0},{x:0,opacity:1,duration:.85,ease:'power3.out'},0);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['stat-poster']=tl;\n})();</script>\n</template></body></html>",
            "compositions/components/axis-scale.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"ui\" data-composition-variables=\"[{&quot;id&quot;:&quot;share&quot;,&quot;type&quot;:&quot;number&quot;,&quot;label&quot;:&quot;How much of the whole it is, from 0 to 1&quot;,&quot;default&quot;:0.62,&quot;sample&quot;:0.62}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"A scale under the figure: ticks and labels, with a marker where the scene's share falls.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.ax{position:absolute;inset:0}.ax-line{position:absolute;left:0;right:0;top:36px;height:2px;background:#2b2650}.ax-tick{position:absolute;top:36px}.ax-tick i{position:absolute;left:0;top:0;width:2px;height:18px;background:#2b2650}.ax-tick b{position:absolute;left:0;top:26px;transform:translateX(-50%);color:#8b93b8;font-size:17px;font-weight:750;letter-spacing:.08em}.ax-mark{position:absolute;left:0;top:8px;width:6px;height:58px;border-radius:3px;background:#ff8f7a;transform:translateX(-50%)}</style>\n<div id=\"root\" data-composition-id=\"axis-scale\" data-duration=\"8\"><span class=\"ax\"><span class=\"ax-line\"></span><span class=\"ax-tick\" style=\"left:0%\"><i></i><b>0</b></span><span class=\"ax-tick\" style=\"left:25%\"><i></i><b>25</b></span><span class=\"ax-tick\" style=\"left:50%\"><i></i><b>50</b></span><span class=\"ax-tick\" style=\"left:75%\"><i></i><b>75</b></span><span class=\"ax-tick\" style=\"left:100%\"><i></i><b>100</b></span><span class=\"ax-mark\"></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"share\":0.62}[key]:v[key])})});\n  var markEl=root.querySelector('.ax-mark');var shareN=Math.max(0,Math.min(1,Number(v.share)||0));if(markEl)markEl.style.left=(shareN*100)+'%';\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.ax'),{opacity:0},{opacity:1,duration:.5,ease:'sine.out'},.5)\n      .fromTo(q('.ax-mark'),{scaleY:0,transformOrigin:'bottom center'},{scaleY:1,duration:.5,ease:'power2.out'},.72);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['axis-scale']=tl;\n})();</script>\n</template></body></html>",
            "compositions/components/source-line.html": "<!doctype html>\n<html lang=\"en\" data-composition-duration=\"8\" data-role=\"piece\" data-composition-variables=\"[{&quot;id&quot;:&quot;source&quot;,&quot;type&quot;:&quot;string&quot;,&quot;label&quot;:&quot;Where the figure came from&quot;,&quot;default&quot;:&quot;the report&quot;,&quot;sample&quot;:&quot;Office for Budget Responsibility, 2024&quot;,&quot;maxLength&quot;:48,&quot;required&quot;:true}]\">\n<head><meta charset=\"UTF-8\" /><meta name=\"description\" content=\"Where the figure came from, set as a fine line: reads the scene's own source.\" /></head>\n<body><template>\n<style>#root{position:absolute;inset:0;box-sizing:border-box}#root *{box-sizing:border-box}.sl{position:absolute;inset:0;display:flex;align-items:center;gap:22px}.sl-line{flex:none;width:120px;height:1px;background:#2b2650}.sl-label{color:#ff8f7a;font-size:16px;font-weight:850;letter-spacing:.18em}.sl-source{flex:1;text-align:right;color:#8b93b8;font-size:22px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}</style>\n<div id=\"root\" data-composition-id=\"source-line\" data-duration=\"8\"><span class=\"sl\"><span class=\"sl-line\"></span><span class=\"sl-label\">WHERE IT COMES FROM</span><span class=\"sl-source\"></span></span></div>\n<script>(function(){\n  var root=document.getElementById('root');\n  var q=function(s){return root.querySelector(s)};\n  var v=window.__hyperframes&&window.__hyperframes.getVariables?window.__hyperframes.getVariables():{};\n  [].forEach(function(key){root.querySelectorAll('.'+key).forEach(function(el){el.textContent=String(v[key]==null?{\"source\":\"the report\"}[key]:v[key])})});\n  var srcEl=root.querySelector('.sl-source');if(srcEl)srcEl.textContent=String(v.source==null?'the report':v.source);\n  var tl=gsap.timeline({paused:true});\n  tl.fromTo(q('.sl'),{opacity:0,y:10},{opacity:1,y:0,duration:.5,ease:'power2.out'},1.05);\n  tl.set({},{},8);\n  tl.seek(0);\n  window.__timelines=window.__timelines||{};window.__timelines['source-line']=tl;\n})();</script>\n</template></body></html>"
