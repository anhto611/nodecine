          "code": {
            "format": "html-gsap",
            "source": "<style>\n  .stage { position: absolute; inset: 0; background: var(--bg); color: var(--fg); font-family: var(--font-body); overflow: hidden; }\n  /* Three bands, and the block owns two of them. The middle one is the stage's: the voice runs\n     there, between what is being compared and whoever is doing the comparing. */\n  .stage .content { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }\n  .stage .captions {\n    position: absolute;\n    left: 96px; right: 96px; top: 46%;\n    display: flex; align-items: center; justify-content: center;\n    text-align: center;\n    font: 700 52px/1.25 var(--font-body);\n    color: var(--fg);\n    --caption-on: var(--accent);\n  }\n  .stage .signature { position: absolute; left: 0; right: 0; bottom: 44px; text-align: center; font: 700 26px/1 var(--font-body); letter-spacing: .08em; color: var(--muted2); }\n\n  /* The character stands in the bottom band of every scene, so it is the stage's, not a block's.\n     It is a drawing in the markup, not a file: a template cannot carry files, but it can carry\n     lines. A scene that brings its own character picture (the block's `character` prop) hides it. */\n  .stage .who-drawn { position: absolute; left: 0; right: 0; top: 56%; bottom: 110px; display: flex; align-items: flex-end; justify-content: center; pointer-events: none; }\n  .stage .who-drawn svg { height: 100%; max-width: 62%; overflow: visible; }\n  .stage:has(.nc-block .who img) .who-drawn { display: none; }\n  /* Two poses, chosen by which block is up: pointing at the cards, or thinking over the question.\n     Odd comparison scenes point the other way, so a run of them does not stand frozen. */\n  .stage .who-drawn .arm-think { display: none; }\n  .stage:has(.nc-block .hero) .who-drawn .arm-point { display: none; }\n  .stage:has(.nc-block .hero) .who-drawn .arm-think { display: block; }\n  .stage:has(.nc-block .compare.flip) .who-drawn svg { transform: scaleX(-1); }\n</style>\n<div class=\"stage\">\n  <div class=\"content\" data-slot=\"content\"></div>\n  <div class=\"captions\" data-slot=\"captions\" data-caption-style=\"karaoke\"></div>\n  <div class=\"who-drawn\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 520 720\" class=\"drawn\">\n  <g class=\"figure\">\n  <!-- bun, behind the head -->\n  <circle fill=\"#5b3f36\" cx=\"312\" cy=\"118\" r=\"40\"/>\n  <circle fill=\"#7a5648\" cx=\"322\" cy=\"108\" r=\"14\"/>\n  <!-- skirt -->\n  <path fill=\"#c7b6e8\" d=\"M200 360 L320 360 L372 630 Q260 662 148 630 Z\"/>\n  <path fill=\"#b39fdc\" d=\"M258 360 L278 360 L300 636 Q280 640 262 640 Z\" opacity=\".5\"/>\n  <path fill=\"#b39fdc\" d=\"M214 360 L232 360 L212 628 Q196 624 184 618 Z\" opacity=\".4\"/>\n  <!-- legs + shoes -->\n  <path fill=\"#f5d3bd\" d=\"M230 628 L226 692 L248 692 L252 630 Z\"/>\n  <path fill=\"#f5d3bd\" d=\"M290 628 L294 692 L272 692 L268 630 Z\"/>\n  <path fill=\"#8b6e63\" d=\"M216 688 L254 688 Q264 692 260 702 L210 702 Q208 692 216 688 Z\"/>\n  <path fill=\"#8b6e63\" d=\"M266 688 L304 688 Q312 692 310 702 L260 702 Q258 692 266 688 Z\"/>\n  <!-- torso -->\n  <path fill=\"#f6c9d2\" d=\"M210 246 Q260 226 310 246 L330 368 L190 368 Z\"/>\n  <path fill=\"none\" stroke=\"#3b2f35\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M244 246 L260 270 L276 246\"/>\n  <rect fill=\"#4a3f58\" x=\"192\" y=\"354\" width=\"136\" height=\"16\" rx=\"6\"/>\n  <rect fill=\"#3b2f35\" x=\"248\" y=\"350\" width=\"24\" height=\"24\" rx=\"5\"/>\n  <!-- arm on hip (viewer's right) -->\n  <path fill=\"none\" stroke=\"#f6c9d2\" stroke-width=\"36\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M306 262 L352 302\"/>\n  <path fill=\"none\" stroke=\"#f5d3bd\" stroke-width=\"26\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M352 302 L322 350\"/>\n  <circle fill=\"#f5d3bd\" cx=\"318\" cy=\"356\" r=\"15\"/>\n  <!-- pointing arm (viewer's left) -->\n  <g class=\"arm-point\">\n    <path fill=\"none\" stroke=\"#f6c9d2\" stroke-width=\"36\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M214 262 L156 206\"/>\n    <path fill=\"none\" stroke=\"#f5d3bd\" stroke-width=\"26\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M156 206 L134 152\"/>\n    <circle fill=\"#f5d3bd\" cx=\"132\" cy=\"146\" r=\"16\"/>\n    <line stroke=\"#2b2b2b\" stroke-width=\"8\" stroke-linecap=\"round\" x1=\"126\" y1=\"134\" x2=\"44\" y2=\"20\"/>\n    <circle fill=\"#2b2b2b\" cx=\"44\" cy=\"20\" r=\"7\"/>\n  </g>\n  <g class=\"arm-think\">\n    <path fill=\"none\" stroke=\"#f6c9d2\" stroke-width=\"36\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M214 262 L190 316\"/>\n    <path fill=\"none\" stroke=\"#f5d3bd\" stroke-width=\"26\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M190 316 L236 232\"/>\n    <line stroke=\"#2b2b2b\" stroke-width=\"8\" stroke-linecap=\"round\" x1=\"326\" y1=\"362\" x2=\"404\" y2=\"474\"/>\n    <circle fill=\"#2b2b2b\" cx=\"404\" cy=\"474\" r=\"7\"/>\n    <circle fill=\"#fff\" stroke=\"#3b2f35\" stroke-width=\"5\" cx=\"326\" cy=\"70\" r=\"8\"/>\n    <circle fill=\"#fff\" stroke=\"#3b2f35\" stroke-width=\"5\" cx=\"350\" cy=\"44\" r=\"13\"/>\n    <path fill=\"#fff\" stroke=\"#3b2f35\" stroke-width=\"5\" d=\"M392 6 Q426 -12 452 10 Q484 2 488 34 Q510 50 490 72 Q484 100 452 92 Q424 110 400 88 Q366 90 370 58 Q360 28 392 6 Z\"/>\n    <text x=\"430\" y=\"68\" font-family=\"Comfortaa, Nunito, system-ui, sans-serif\" font-weight=\"700\" font-size=\"54\" text-anchor=\"middle\" fill=\"#3b2f35\">?</text>\n  <circle fill=\"#f5d3bd\" cx=\"240\" cy=\"222\" r=\"15\"/>\n  </g>\n  <!-- neck + head -->\n  <path fill=\"#e9bda3\" d=\"M246 216 L274 216 L274 250 Q260 258 246 250 Z\"/>\n  <ellipse fill=\"#f5d3bd\" cx=\"260\" cy=\"160\" rx=\"56\" ry=\"62\"/>\n  <path fill=\"#5b3f36\" d=\"M202 150 Q204 80 262 80 Q322 80 318 154 Q304 116 268 126 Q244 114 232 138 Q216 126 202 150 Z\"/>\n  <path fill=\"#7a5648\" d=\"M262 84 Q300 88 312 134 Q296 110 266 116 Z\"/>\n  <circle fill=\"#3b2f35\" cx=\"240\" cy=\"168\" r=\"6\"/>\n  <circle fill=\"#3b2f35\" cx=\"284\" cy=\"168\" r=\"6\"/>\n  <path fill=\"none\" stroke=\"#3b2f35\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M230 152 Q240 146 250 152\"/>\n  <path fill=\"none\" stroke=\"#3b2f35\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M274 152 Q284 146 294 152\"/>\n  <path fill=\"none\" stroke=\"#3b2f35\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M250 192 Q262 202 274 192\"/>\n  <circle fill=\"#f2a9ae\" cx=\"226\" cy=\"186\" r=\"9\" opacity=\".7\"/>\n  <circle fill=\"#f2a9ae\" cx=\"296\" cy=\"186\" r=\"9\" opacity=\".7\"/>\n  </g>\n</svg></div>\n  <div class=\"signature\">@kenh-cua-ban</div>\n</div>"
