          "blocks": [
            {
              "id": "hero-question",
              "name": "Câu hỏi mở",
              "doc": {
                "when": "the beat asks the question the video answers, or closes it — one line, no comparison yet",
                "example": "{\"headline\":\"Website và Web App *khác nhau* chỗ nào?\"}"
              },
              "props": {
                "headline": {
                  "type": "string",
                  "content": "title",
                  "required": true,
                  "max": 70,
                  "hint": "the question or the closing line"
                },
                "character": {
                  "type": "image",
                  "content": "image",
                  "required": false,
                  "hint": "the person doing the talking, a drawing on a clear background"
                }
              },
              "code": {
                "format": "html-gsap",
                "source": "<div class=\"wrap hero\">\n  <div class=\"q-box\"><h1 class=\"q\" data-prop=\"headline\"></h1></div>\n  <div class=\"who\" data-if=\"character\"><img data-prop=\"character\" alt=\"\"></div>\n</div>\n<style>\n  .wrap { position: absolute; inset: 0; }\n  /* Centred in the same band the cards use, so the question and the comparison sit at one height\n     and the cut between them does not jump. */\n  .q-box { position: absolute; left: 96px; right: 96px; top: 96px; bottom: 56%; display: flex; align-items: center; justify-content: center; }\n  /* The heading is a block inside the centring box, not the flex container itself: a flex h1 turns\n     each *emphasised phrase* into its own item, and \"khác nhau\" stacks in a column beside the rest. */\n  .q { margin: 0; font: 800 92px/1.15 var(--font-display); color: var(--fg); text-align: center; }\n  .q .nc-emph { color: var(--accent); font-style: normal; }\n  .who { position: absolute; left: 0; right: 0; top: 56%; bottom: 110px; display: flex; align-items: flex-end; justify-content: center; }\n  .who img { max-width: 62%; max-height: 100%; object-fit: contain; }\n</style>"
              }
            },
            {
              "id": "compare-cards",
              "name": "Hai thẻ so sánh",
              "doc": {
                "when": "the beat sets two things against each other: one card each, a name and a line",
                "example": "{\"cards\":[{\"label\":\"Website\",\"title\":\"Đọc là chính\",\"image\":\"data:image/svg+xml;base64,…\"},{\"label\":\"Web App\",\"title\":\"Làm là chính\",\"image\":\"data:image/svg+xml;base64,…\"}]}"
              },
              "props": {
                "cards": {
                  "type": "entries",
                  "content": "entries",
                  "required": true,
                  "min": 2,
                  "max": 2,
                  "of": [
                    "label",
                    "title",
                    "image"
                  ],
                  "hint": "the two sides: a name, a line, and a picture"
                },
                "character": {
                  "type": "image",
                  "content": "image",
                  "required": false,
                  "hint": "the person doing the talking"
                }
              },
              "code": {
                "format": "html-gsap",
                "source": "<div class=\"wrap compare\">\n  <div class=\"band\"><div class=\"cards\" data-prop=\"cards\">\n    <div class=\"card\">\n      <div class=\"lab\" data-prop=\"label\"></div>\n      <div class=\"pic\" data-if=\"image\"><img data-prop=\"image\" alt=\"\"></div>\n      <div class=\"ttl\" data-prop=\"title\"></div>\n    </div>\n  </div></div>\n  <div class=\"who\" data-if=\"character\"><img data-prop=\"character\" alt=\"\"></div>\n</div>\n<style>\n  .wrap { position: absolute; inset: 0; }\n  /* Two cards of equal width, whatever their words: a comparison where one side is wider reads as\n     the wider side mattering more. Any number the block is given is laid out the same way. */\n  /* The band above the voice. The row inside it is only as tall as its cards, and is centred in the\n     band: with pictures the cards are tall, without them they are a compact pair in the upper half\n     rather than two empty boxes reaching for the captions. */\n  .band { position: absolute; left: 72px; right: 72px; top: 96px; bottom: 56%; display: flex; align-items: center; }\n  .cards { width: 100%; max-height: 100%; display: flex; align-items: stretch; gap: 40px; }\n  .card { flex: 1 1 0; min-width: 0; background: var(--panel); border: 3px solid var(--line); border-radius: 40px; padding: 44px 36px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; }\n  .lab { font: 800 54px/1.1 var(--font-display); color: var(--accent); text-align: center; }\n  /* Each side its own colour, so the two are told apart before a word is read. */\n  .card:nth-child(2) .lab { color: var(--accent2, var(--accent)); }\n  /* The picture is optional and the card must not collapse without it, so the box only exists when\n     there is one. The template ships two drawings inline; a person swaps in their own. */\n  .pic { height: 320px; align-self: stretch; display: flex; align-items: center; justify-content: center; }\n  .pic img { max-width: 100%; max-height: 100%; object-fit: contain; }\n  .ttl { font: 500 34px/1.35 var(--font-body); color: var(--fg); text-align: center; }\n  /* The character stands in the bottom band, under the captions. Contained, not cropped: a drawing\n     cut off at the ankles is the first thing that makes one of these look cheap. */\n  .who { position: absolute; left: 0; right: 0; top: 56%; bottom: 110px; display: flex; align-items: flex-end; justify-content: center; }\n  .who img { max-width: 62%; max-height: 100%; object-fit: contain; }\n</style>\n<script>\n  // Every other comparison faces the other way; the stage reads this class to mirror the character.\n  if (nodecine.index % 2) nodecine.root.querySelector(\".compare\").classList.add(\"flip\");\n</script>"
              }
            }
