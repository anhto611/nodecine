          },
          "tokens": {
            "palette": {
              "bg": "#05060a",
              "bg2": "#0d1016",
              "panel": "#12151c",
              "line": "#242832",
              "fg": "#ffffff",
              "muted": "rgba(255,255,255,.72)",
              "muted2": "rgba(255,255,255,.45)",
              "accent": "#ffd166"
            },
            "fonts": {
              "display": "'Comfortaa', 'Be Vietnam Pro', system-ui, sans-serif",
              "body": "'Comfortaa', 'Be Vietnam Pro', system-ui, sans-serif"
            }
          },
          "tones": {},
          "sceneFields": [],
          "vars": {},
          "transition": {
            "type": "cut",
            "seconds": 0.4
          },
          "code": {
            "format": "html-gsap",
            "source": "<style>\n  .stage { position: absolute; inset: 0; background: var(--bg); color: var(--fg); font-family: var(--font-body); overflow: hidden; }\n  .stage .content { position: absolute; inset: 0; }\n  /* One line at the bottom, never two: on a landscape frame a second line reads as a caption\n     under a photo, not as subtitles. The character cap on the Captions node is what keeps it\n     to one line — this only refuses to wrap, so an over-long cue is visibly clipped instead of\n     quietly climbing out of the band. */\n  .stage .captions {\n    position: absolute;\n    left: 160px; right: 160px; bottom: 150px;\n    display: flex; align-items: flex-end; justify-content: center;\n    text-align: center; white-space: nowrap;\n    font: 700 44px/1.3 var(--font-body);\n    color: #fff;\n    /* Ink that survives any photograph: a stroke first, then the fill, then a soft drop. */\n    -webkit-text-stroke: 0.14em rgba(0,0,0,.92);\n    paint-order: stroke fill;\n    text-shadow: 0 3px 14px rgba(0,0,0,.45);\n    --caption-on: var(--accent);\n  }\n</style>\n<div class=\"stage\">\n  <div class=\"content\" data-slot=\"content\"></div>\n  <div class=\"captions\" data-slot=\"captions\" data-caption-style=\"reveal\"></div>\n</div>"
          },
          "blocks": [
            {
              "id": "still",
              "name": "Still",
              "doc": {
                "example": "{\"picture\":\"/api/assets/<hash>.jpg\"}",
                "when": "A photograph filling the frame while the voice talks over it. The picture sets the mood; it does not have to illustrate the words."
              },
              "props": {
                "picture": {
                  "type": "image",
                  "content": "image",
                  "required": false,
                  "hint": "a photograph filling the frame"
                }
              },
              "code": {
                "format": "html-gsap",
                "source": "<div class=\"shot\"><img data-prop=\"picture\" alt=\"\"></div>\n<style>\n  .shot { position: absolute; inset: 0; overflow: hidden; border-radius: 112px; background: var(--bg2); }\n  .shot img { position: absolute; left: 50%; top: 50%; width: 1920px; height: 1080px; margin: -540px 0 0 -960px; object-fit: cover; transform-origin: center center; }\n</style>\n<script>\n  nodecine.timeline(gsap.timeline().fromTo(\".shot img, .shot video\",\n    { scale: 1.06, xPercent: 0 },\n    { scale: 1.14, xPercent: -1.2, duration: Math.max(3, nodecine.duration || 4), ease: \"none\" }, 0));\n</script>"
              }
            },
            {
              "id": "still-clip",
              "name": "Clip",
              "doc": {
                "example": "{\"footage\":\"/api/assets/<hash>.mp4\"}",
                "when": "The same frame as Still, but moving: a clip from the clips folder instead of a photograph."
              },
              "props": {
                "footage": {
                  "type": "video",
                  "content": "clip",
                  "required": false,
                  "hint": "a clip filling the frame"
                }
              },
              "code": {
                "format": "html-gsap",
                "source": "<div class=\"shot\"><video data-prop=\"footage\"></video></div>\n<style>\n  .shot { position: absolute; inset: 0; overflow: hidden; border-radius: 112px; background: var(--bg2); }\n  .shot video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n</style>"
              }
            }
          ],
          "covers": [
            {
              "id": "portrait-cover",
              "name": "Bìa dọc",
              "frame": {
                "width": 1080,
                "height": 1920
              },
              "props": {
                "picture": {
                  "type": "image",
                  "required": false,
                  "hint": "the photograph behind the words"
                },
                "title": {
                  "type": "text",
                  "required": true,
                  "max": 90,
                  "hint": "the line that has to make someone stop"
                },
                "subtitle": {
                  "type": "string",
                  "required": false,
                  "max": 60
                }
              },
              "code": {
                "format": "html-gsap",
                "source": "<div class=\"cv\">\n  <img class=\"cv-shot\" data-prop=\"picture\" alt=\"\">\n  <div class=\"cv-text\">\n    <div class=\"cv-title\" data-prop=\"title\"></div>\n    <div class=\"cv-sub\" data-prop=\"subtitle\" data-if=\"subtitle\"></div>\n  </div>\n</div>\n<style>\n  /* A ground of its own, so a cover with no photograph chosen yet is still a design and not\n     a black rectangle. The picture covers it whole when there is one. */\n  .cv { position: absolute; inset: 0; background: linear-gradient(155deg, var(--bg2) 0%, var(--bg) 62%, #000 100%); }\n  .cv-shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n  /* Centred on the FRAME, not inside a safe area: \"the words in the middle of the picture\".\n     Margins 220 a side leave a 640px column (59% of the frame) — wider than the platform's own\n     safe inset of 168, because on a real TikTok screenshot text at 168 still touches the button\n     column, and a frame whose only content is words needs more room than the minimum. */\n  /* The TITLE is what sits dead centre, and the subtitle hangs below it — so adding a subtitle\n     does not shove the title off the middle of the picture. Taking the subtitle out of the flow\n     is what buys that without having to measure the title first. */\n  .cv-text { position: absolute; left: 220px; right: 220px; top: 50%; transform: translateY(-50%); text-align: center; }\n  .cv-sub { position: absolute; left: 0; right: 0; top: 100%; }\n  /* 58px, the size of a caption and not much more. An earlier version doubled it for the channel\n     grid and was dropped: the cover stopped looking like the film. The point is a frame of the\n     video with one still sentence where the running subtitles would be. */\n  .cv-title { font: 700 58px/1.35 var(--font-body); color: #fff; }\n  .cv-sub { margin-top: 28px; font: 700 36px/1.3 var(--font-body); color: #fff; }\n  /* No wash over the photograph. Ink is what keeps the words readable on any picture: the stroke\n     is painted first and the fill over it, so the letters keep their shape instead of thickening. */\n  .cv-title, .cv-sub { -webkit-text-stroke: .14em rgba(0,0,0,.92); paint-order: stroke fill; text-shadow: 0 3px 14px rgba(0,0,0,.45); }\n</style>"
              },
              "defaults": {
                "title": "Tiêu đề của bìa"
              }
            }
          ],
          "casting": []
