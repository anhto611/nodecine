# All optional. Local providers need no key; the hosted voices below read theirs from here (docs/ARCHITECTURE.md §4).
# GITHUB_TOKEN=            # raises the GitHub API rate limit (Phase B)
# NODECINE_CLAUDE_BIN=     # override the `claude` binary path if auto-detection fails
# NODECINE_FFMPEG_BIN=     # override the ffmpeg binary path
# NODECINE_TMP_DIR=.nodecine/tmp
# NODECINE_ASSETS_DIR=.nodecine/assets   # images a look refers to, kept forever, named by content hash

# Piper voice: binary override and where the .onnx voice models live
# NODECINE_PIPER_BIN=/opt/homebrew/bin/piper
# NODECINE_PIPER_VOICES=~/.local/share/piper-voices

# ElevenLabs voices (29 languages, one multilingual model)
# ELEVENLABS_API_KEY=

# Vbee voices (Vietnamese by region)
# VBEE_TOKEN=
# VBEE_APP_ID=

# Transcribe node: interpreter with stable-ts. Default is the venv `npm run setup:align` creates.
# NODECINE_ALIGN_PYTHON=.nodecine/tools/stable-ts/bin/python
