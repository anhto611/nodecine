{
  "name": "nodecine",
  "version": "0.1.0",
  "private": true,
  "description": "The open-source node-based agentic video studio",
  "scripts": {
    "nodes:discover": "node scripts/discover-nodes.mjs",
    "nodes:check": "node scripts/check-node-boundaries.mjs",
    "nodes:prepare": "npm run nodes:discover && npm run providers:discover && npm run nodes:check",
    "predev": "npm run nodes:prepare",
    "dev": "next dev",
    "prebuild": "npm run nodes:prepare",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "npm run nodes:prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run nodes:prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:align": "bash scripts/setup-align.sh",
    "providers:discover": "node scripts/discover-providers.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@dagrejs/dagre": "^3.1.1",
    "@hyperframes/core": "^0.8.29",
    "@hyperframes/player": "^0.8.29",
    "@hyperframes/producer": "^0.8.29",
    "@remotion/bundler": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.3.0",
    "gsap": "^3.15.0",
    "next": "^15.1.0",
    "puppeteer": "^25.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-rnd": "^10.5.3",
    "remotion": "^4.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
