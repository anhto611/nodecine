{
  "name": "nodecine",
  "version": "0.1.0",
  "private": true,
  "description": "The open-source node-based agentic video studio",
  "scripts": {
    "capsules:discover": "node scripts/discover-capsules.mjs",
    "capsules:check": "node scripts/check-boundaries.mjs",
    "capsules:prepare": "npm run capsules:discover && npm run providers:discover && npm run capsules:check && npm run vendor:three",
    "vendor:three": "node capsules/engines/hyperframes/vendor-three.mjs",
    "predev": "npm run capsules:prepare",
    "dev": "next dev",
    "prebuild": "npm run capsules:prepare",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "npm run capsules:prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run capsules:prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:align": "bash capsules/nodes/transcribe/setup-align.sh",
    "providers:discover": "node scripts/discover-providers.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@hyperframes/core": "^0.8.29",
    "@hyperframes/player": "^0.8.29",
    "@hyperframes/producer": "^0.8.29",
    "@xyflow/react": "^12.3.0",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "next": "^15.1.0",
    "puppeteer": "^25.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
