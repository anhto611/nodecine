   "source": "<div class=\"s4-root\">\n  <div class=\"s4-glow\" aria-hidden=\"true\"></div>\n\n  <p class=\"label s4-label\">Tính năng</p>\n\n  <h2 class=\"title s4-title\">Widget ngay trên <span class=\"accent\">màn hình khoá</span></h2>\n\n  <p class=\"paragraph s4-para\">Thói quen hôm nay nằm sẵn ở đó. Không cần mở app, chỉ cần liếc một cái.</p>\n\n  <div class=\"s4-phone-pos\" aria-hidden=\"true\">\n    <div class=\"s4-phone-wrap\">\n      <div class=\"s4-phone-float\">\n        <div class=\"phone\">\n          <div class=\"screen\">\n            <div class=\"s4-time\">6:12</div>\n            <div class=\"s4-datebar\"></div>\n            <div class=\"s4-widget\">\n              <div class=\"s4-w-head\"><span class=\"s4-head-dot\"></span><span class=\"s4-bar s4-bar-head\"></span></div>\n              <div class=\"s4-w-row\"><span class=\"s4-ring s4-ring-done\"></span><span class=\"s4-bar\" style=\"width:214px\"></span></div>\n              <div class=\"s4-w-row\"><span class=\"s4-ring s4-ring-done\"></span><span class=\"s4-bar\" style=\"width:168px\"></span></div>\n              <div class=\"s4-w-row\"><span class=\"s4-ring s4-ring-open\"></span><span class=\"s4-bar s4-bar-dim\" style=\"width:196px\"></span></div>\n            </div>\n            <div class=\"s4-hint\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.s4-root { position: absolute; inset: 0; overflow: hidden; }\n\n.s4-glow {\n  position: absolute;\n  left: 292px;\n  top: 422px;\n  width: 920px;\n  height: 920px;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(255, 180, 84, 0.28) 0%, rgba(255, 180, 84, 0.10) 42%, rgba(255, 180, 84, 0) 70%);\n  filter: blur(18px);\n  pointer-events: none;\n}\n\n.s4-label { position: absolute; left: 72px; top: 280px; }\n\n.s4-title {\n  position: absolute;\n  left: 72px;\n  top: 336px;\n  width: 820px;\n  max-width: 820px;\n  font-size: 92px;\n}\n\n.s4-para {\n  position: absolute;\n  left: 72px;\n  top: 672px;\n  width: 470px;\n  max-width: 470px;\n}\n\n.s4-phone-pos {\n  position: absolute;\n  left: 592px;\n  top: 545px;\n  width: 520px;\n  transform: scale(0.6154);\n  transform-origin: top left;\n}\n\n.s4-time {\n  font-family: var(--font-display);\n  font-size: 108px;\n  font-weight: 800;\n  line-height: 1;\n  letter-spacing: -0.04em;\n  text-align: center;\n  margin-top: 36px;\n  color: var(--fg);\n}\n\n.s4-datebar {\n  width: 150px;\n  height: 12px;\n  border-radius: 999px;\n  background: rgba(247, 242, 234, 0.22);\n  margin: 0 auto;\n}\n\n.s4-widget {\n  box-sizing: border-box;\n  margin-top: 40px;\n  padding: 32px 30px;\n  border-radius: 34px;\n  border: 1px solid var(--line);\n  background: rgba(247, 242, 234, 0.07);\n  display: flex;\n  flex-direction: column;\n  gap: 26px;\n}\n\n.s4-w-head { display: flex; align-items: center; gap: 18px; }\n\n.s4-head-dot {\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: rgba(247, 242, 234, 0.45);\n}\n\n.s4-bar-head { width: 132px; height: 12px; background: rgba(247, 242, 234, 0.30); }\n\n.s4-w-row { display: flex; align-items: center; gap: 22px; }\n\n.s4-ring {\n  position: relative;\n  flex: none;\n  display: inline-block;\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  box-sizing: border-box;\n}\n\n.s4-ring-done { background: rgba(247, 242, 234, 0.32); }\n\n.s4-ring-done::after {\n  content: \"\";\n  position: absolute;\n  left: 11px;\n  top: 8px;\n  width: 9px;\n  height: 16px;\n  border-right: 3px solid var(--fg);\n  border-bottom: 3px solid var(--fg);\n  transform: rotate(42deg);\n}\n\n.s4-ring-open {\n  border: 3px solid var(--accent);\n  box-shadow: 0 0 26px rgba(255, 180, 84, 0.45);\n}\n\n.s4-bar {\n  height: 14px;\n  border-radius: 999px;\n  background: rgba(247, 242, 234, 0.26);\n}\n\n.s4-bar-dim { background: rgba(247, 242, 234, 0.16); }\n\n.s4-hint {\n  width: 140px;\n  height: 10px;\n  border-radius: 999px;\n  background: rgba(247, 242, 234, 0.20);\n  margin: auto auto 10px;\n}\n</style>\n\n<script>\n(function () {\n  var D = nodecine.duration;\n  var tTitle = nodecine.when(\"Widget nằm sẵn trên màn hình khoá\");\n  var tBody = nodecine.when(\"Liếc một cái là biết hôm nay còn gì chưa xong\");\n\n  var tl = gsap.timeline();\n\n  tl.fromTo('.s4-glow',\n    { opacity: 0.35, scale: 0.86 },\n    { opacity: 0.9, scale: 1.12, duration: D, ease: 'sine.inOut' }, 0);\n\n  tl.fromTo('.s4-phone-float',\n    { y: 0 },\n    { y: -18, duration: D / 2, ease: 'sine.inOut', yoyo: true, repeat: 1 }, 0);\n\n  tl.fromTo('.s4-label',\n    { opacity: 0, y: 22 },\n    { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }, 0.15);\n\n  tl.fromTo('.s4-title',\n    { opacity: 0, y: 44 },\n    { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out' }, tTitle);\n\n  tl.fromTo('.s4-phone-wrap',\n    { opacity: 0, y: 72 },\n    { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out' }, tTitle + 0.15);\n\n  tl.fromTo('.s4-w-row',\n    { opacity: 0, x: -20 },\n    { opacity: 1, x: 0, duration: 0.5, stagger: 0.14, ease: 'power2.out' }, tTitle + 0.7);\n\n  tl.fromTo('.s4-para',\n    { opacity: 0, y: 30 },\n    { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, tBody);\n\n  tl.fromTo('.s4-ring-open',\n    { opacity: 0.45, scale: 0.9 },\n    { opacity: 1, scale: 1, duration: 0.9, ease: 'sine.inOut', yoyo: true, repeat: 5 }, tBody);\n\n  nodecine.timeline(tl);\n})();\n</script>"
