   "source": "<div class=\"s1-wrap\">\n  <div class=\"s1-glow\" aria-hidden=\"true\"></div>\n  <div class=\"s1-content\">\n    <p class=\"label s1-label\">Buổi sáng</p>\n    <h1 class=\"title s1-title\">Sáng nào cũng <em class=\"nc-emph accent\">trôi mất</em> trước khi bạn kịp bắt đầu</h1>\n    <p class=\"paragraph s1-body\">Lumen là ứng dụng iOS ghi lại thói quen buổi sáng của bạn.</p>\n  </div>\n</div>\n\n<style>\n  .s1-wrap {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n  }\n\n  .s1-glow {\n    position: absolute;\n    left: 50%;\n    bottom: -420px;\n    width: 1500px;\n    height: 1100px;\n    margin-left: -750px;\n    border-radius: 50%;\n    background: radial-gradient(closest-side, rgba(255, 180, 84, 0.30) 0%, rgba(255, 180, 84, 0.10) 48%, rgba(255, 180, 84, 0) 78%);\n    filter: blur(10px);\n    pointer-events: none;\n  }\n\n  .s1-content {\n    position: absolute;\n    left: 96px;\n    right: 168px;\n    top: 260px;\n    bottom: 680px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: flex-start;\n    gap: 44px;\n  }\n\n  .s1-title {\n    max-width: 816px;\n  }\n\n  .s1-body {\n    max-width: 740px;\n  }\n\n  .nc-emph {\n    font-style: normal;\n  }\n</style>\n\n<script>\n  const d = nodecine.duration;\n  const tl = gsap.timeline();\n\n  tl.fromTo('.s1-glow',\n    { opacity: 0.34, scale: 0.9, yPercent: 8 },\n    { opacity: 0.78, scale: 1.14, yPercent: -2, duration: d, ease: 'sine.inOut' }, 0);\n\n  tl.fromTo('.s1-label',\n    { opacity: 0, y: 26 },\n    { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }, nodecine.when('Bạn thức dậy'));\n\n  tl.fromTo('.s1-title',\n    { opacity: 0, y: 54 },\n    { opacity: 1, y: 0, duration: 0.95, ease: 'power3.out' }, nodecine.when('rồi nửa buổi sáng biến mất'));\n\n  tl.fromTo('.s1-body',\n    { opacity: 0, y: 34 },\n    { opacity: 1, y: 0, duration: 0.85, ease: 'power2.out' }, nodecine.when('Lumen giữ lại thói quen sáng của bạn'));\n\n  nodecine.time