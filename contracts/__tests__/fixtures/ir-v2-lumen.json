   "source": "<div class=\"s3-glow\"></div>\n<div class=\"s3\">\n  <p class=\"label s3-kicker\">Tính năng</p>\n  <h1 class=\"title s3-title\">Biểu đồ chuỗi ngày <em class=\"accent\">không đứt</em></h1>\n  <hr class=\"divider s3-divider\">\n  <div class=\"s3-chart\">\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:22\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:30\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:26\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:38\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:34\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:46\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:42\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:54\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:50\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill\" style=\"--h:62\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill s3-on\" style=\"--h:70\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill s3-on\" style=\"--h:78\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill s3-on\" style=\"--h:88\"></span></div>\n    <div class=\"s3-bar\"><span class=\"s3-fill s3-on s3-last\" style=\"--h:100\"></span></div>\n  </div>\n  <p class=\"paragraph s3-body\">Mỗi ngày hoàn thành là một mắt xích. Bạn nhìn thấy chuỗi dài ra và không muốn làm nó gãy.</p>\n</div>\n\n<style>\n  .s3 {\n    position: absolute;\n    left: 96px;\n    top: 282px;\n    width: 816px;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n  }\n\n  .s3-kicker { margin-bottom: 30px; }\n\n  .s3-title {\n    font-size: 92px;\n    max-width: 816px;\n    margin-bottom: 34px;\n  }\n\n  .s3-divider { margin-bottom: 44px; }\n\n  .s3-chart {\n    box-sizing: border-box;\n    width: 816px;\n    height: 282px;\n    display: flex;\n    align-items: flex-end;\n    gap: 14px;\n    padding-bottom: 14px;\n    border-bottom: 1px solid var(--line);\n    margin-bottom: 46px;\n  }\n\n  .s3-bar {\n    flex: 1 1 0;\n    height: 100%;\n    display: flex;\n    align-items: flex-end;\n  }\n\n  .s3-fill {\n    display: block;\n    width: 100%;\n    height: calc(var(--h) * 1%);\n    border-radius: 12px;\n    transform-origin: 50% 100%;\n    background-color: rgba(247, 242, 234, 0.05);\n    background-image: repeating-linear-gradient(\n      to bottom,\n      rgba(247, 242, 234, 0.24) 0 16px,\n      rgba(247, 242, 234, 0) 16px 24px\n    );\n  }\n\n  .s3-on {\n    background-color: rgba(255, 180, 84, 0.10);\n    background-image: repeating-linear-gradient(\n      to bottom,\n      rgba(255, 180, 84, 0.92) 0 16px,\n      rgba(255, 180, 84, 0) 16px 24px\n    );\n  }\n\n  .s3-last { box-shadow: 0 0 40px rgba(255, 180, 84, 0.38); }\n\n  .s3-body { max-width: 800px; }\n\n  .s3-glow {\n    position: absolute;\n    left: 250px;\n    top: 560px;\n    width: 720px;\n    height: 720px;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(255, 180, 84, 0.20) 0%, rgba(255, 180, 84, 0) 68%);\n    pointer-events: none;\n  }\n</style>\n\n<script>\n  const d = nodecine.duration;\n  const tl = gsap.timeline();\n\n  tl.fromTo('.s3-glow',\n    { scale: 0.82, opacity: 0.5, xPercent: -6 },\n    { scale: 1.14, opacity: 0.95, xPercent: 6, duration: d, ease: 'sine.inOut' }, 0);\n\n  tl.fromTo('.s3-kicker',\n    { opacity: 0, y: 26 },\n    { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, 0);\n\n  tl.fromTo('.s3-title',\n    { opacity: 0, y: 40 },\n    { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, 0.15);\n\n  tl.fromTo('.s3-divider',\n    { opacity: 0, scaleX: 0, transformOrigin: '0% 50%' },\n    { opacity: 0.85, scaleX: 1, duration: 0.6, ease: 'power2.out' }, 0.45);\n\n  tl.fromTo('.s3-fill',\n    { scaleY: 0, opacity: 0 },\n    { scaleY: 1, opacity: 1, duration: 0.5, ease: 'power2.out', stagger: 0.075 },\n    nodecine.when('Chuỗi ngày hiện thành biểu đồ'));\n\n  tl.fromTo('.s3-last',\n    { boxShadow: '0 0 20px rgba(255, 180, 84, 0.20)' },\n    { boxShadow: '0 0 70px rgba(255, 180, 84, 0.55)', duration: 2.2, ease: 'sine.inOut', repeat: -1, yoyo: true },\n    Math.min(d - 0.4, nodecine.when('Chuỗi ngày hiện thành biểu đồ') + 1.4));\n\n  tl.fromTo('.s3-body',\n    { opacity: 0, y: 32 },\n    { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' },\n    nodecine.when('Càng nhìn nó dài ra, bạn càng không muốn bỏ'));\n\n  nodecine.timeline(tl);\n</script>"
