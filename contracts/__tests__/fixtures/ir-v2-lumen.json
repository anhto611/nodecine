   "source": "<div class=\"s5-root\">\n  <div class=\"s5-glow\" aria-hidden=\"true\"></div>\n\n  <div class=\"s5-content\">\n    <p class=\"label s5-kicker\">Tải ngay</p>\n    <h1 class=\"title s5-title\">Tải <span class=\"accent\">miễn phí</span> trên App Store</h1>\n    <p class=\"paragraph s5-body\">Dùng miễn phí ngay từ sáng mai. Gói Pro 49.000 đồng một tháng khi bạn muốn nhiều hơn.</p>\n  </div>\n\n  <style>\n    .s5-root {\n      position: absolute;\n      inset: 0;\n      overflow: hidden;\n    }\n\n    .s5-glow {\n      position: absolute;\n      left: 50%;\n      bottom: -260px;\n      width: 1240px;\n      height: 980px;\n      margin-left: -620px;\n      border-radius: 50%;\n      background: radial-gradient(closest-side, rgba(255, 180, 84, 0.30) 0%, rgba(255, 180, 84, 0.10) 48%, rgba(255, 180, 84, 0) 78%);\n      opacity: 0.5;\n      pointer-events: none;\n    }\n\n    .s5-content {\n      position: absolute;\n      left: 96px;\n      right: 168px;\n      top: 300px;\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 44px;\n    }\n\n    .s5-kicker {\n      opacity: 0;\n    }\n\n    .s5-title {\n      max-width: 816px;\n      opacity: 0;\n    }\n\n    .s5-body {\n      max-width: 760px;\n      margin-top: 12px;\n      opacity: 0;\n    }\n  </style>\n\n  <script>\n    const tl = gsap.timeline();\n\n    tl.fromTo('.s5-glow',\n      { scale: 0.88, opacity: 0.40, yPercent: 4 },\n      { scale: 1.16, opacity: 0.82, yPercent: -3, duration: nodecine.duration, ease: 'none' },\n      0);\n\n    const tDownload = nodecine.when('Tải Lumen miễn phí trên App Store');\n    const tPro = nodecine.when('Muốn thêm thì Pro bốn chín nghìn mỗi tháng');\n\n    tl.fromTo('.s5-kicker',\n      { opacity: 0, y: 28 },\n      { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' },\n      tDownload);\n\n    tl.fromTo('.s5-title',\n      { opacity: 0, y: 46 },\n      { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' },\n      tDownload + 0.14);\n\n    tl.fromTo('.s5-body',\n      { opacity: 0, y: 36 },\n      { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' },\n      tPro);\n\n    nodecine.timeline(tl);\n  </script>\n</div>"
