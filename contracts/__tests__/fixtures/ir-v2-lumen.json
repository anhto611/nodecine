   "source": "<div class=\"s2-wrap\">\n  <div class=\"s2-glow\" aria-hidden=\"true\"></div>\n\n  <div class=\"s2-col\">\n    <span class=\"s2-rail\" aria-hidden=\"true\"></span>\n    <p class=\"label s2-kicker\">Tính năng</p>\n    <h1 class=\"title s2-title\">Nhắc theo <span class=\"accent\">ngữ cảnh</span>, không theo giờ cứng</h1>\n    <p class=\"paragraph s2-body\">App nhắc khi bạn thật sự sẵn sàng, thay vì réo lên đúng bảy giờ rồi bị tắt đi.</p>\n  </div>\n</div>\n\n<style>\n  .s2-wrap {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n  }\n\n  .s2-glow {\n    position: absolute;\n    left: -160px;\n    top: 520px;\n    width: 900px;\n    height: 900px;\n    border-radius: 50%;\n    background: radial-gradient(circle at 50% 50%, rgba(255, 180, 84, 0.16) 0%, rgba(255, 180, 84, 0.05) 45%, rgba(255, 180, 84, 0) 72%);\n    pointer-events: none;\n  }\n\n  .s2-col {\n    position: absolute;\n    left: 96px;\n    top: 300px;\n    width: 816px;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 44px;\n    padding-left: 40px;\n  }\n\n  .s2-rail {\n    position: absolute;\n    left: 0;\n    top: 8px;\n    bottom: 8px;\n    width: 3px;\n    border-radius: 3px;\n    background: linear-gradient(180deg, rgba(247, 242, 234, 0.28), rgba(247, 242, 234, 0.04));\n    transform-origin: 50% 0%;\n  }\n\n  .s2-title {\n    max-width: 800px;\n  }\n\n  .s2-body {\n    max-width: 740px;\n  }\n</style>\n\n<script>\n  const tl = gsap.timeline();\n\n  tl.fromTo(\".s2-glow\",\n    { opacity: 0.5, scale: 0.86, x: -60, y: 30 },\n    { opacity: 1, scale: 1.18, x: 70, y: -40, duration: nodecine.duration, ease: \"none\" }, 0);\n\n  tl.fromTo(\".s2-rail\",\n    { scaleY: 0, opacity: 0 },\n    { scaleY: 1, opacity: 1, duration: 1.4, ease: \"power2.out\" }, 0.15);\n\n  tl.fromTo(\".s2-kicker\",\n    { opacity: 0, y: 26 },\n    { opacity: 1, y: 0, duration: 0.6, ease: \"power2.out\" }, 0);\n\n  tl.fromTo(\".s2-title\",\n    { opacity: 0, y: 46 },\n    { opacity: 1, y: 0, duration: 0.9, ease: \"power3.out\" },\n    nodecine.when(\"Không có chuông reo lúc bảy giờ\"));\n\n  tl.fromTo(\".s2-body\",\n    { opacity: 0, y: 30 },\n    { opacity: 1, y: 0, duration: 0.8, ease: \"power2.out\" },\n    nodecine.when(\"Lumen nhắc đúng lúc bạn đang sẵn sàng làm\"));\n\n  tl.fromTo(\".s2-col\",\n    { y: 0 },\n    { y: -22, duration: nodecine.duration, ease: \"none\" }, 0);\n\n  nodecine.timeline(tl);\n</script>"
